; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DroneFlames v0.33.5.35-test (PC Port by @droneflamesmod)"
config/use_custom_user_dir=true
config/custom_user_dir_name="DroneFlames-PC-Port_test"
run/main_scene="res://game/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color="#0f1c45"
boot_splash/stretch_mode=4
boot_splash/use_filter=false
boot_splash/image="res://splash.png"
config/icon="res://icon.png"
config/windows_native_icon="res://app_icon.ico"

[autoload]

UserDataMigration="*res://core/user_data_migration.gd"
Watermark="*res://watermark.gd"
Updater="*res://net/github_updater.gd"
ModManager="*res://core/mod_manager.gd"
LocalWorkshop="*res://core/local_workshop.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[editor_plugins]

enabled=PackedStringArray()

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[threading]

worker_pool/low_priority_thread_ratio.android=0.125
worker_pool/low_priority_thread_ratio.windows=0.3
