#: game/diplomacy.gd:1490
msgid "%s призывает к войне с %s"
msgstr "%s llama a la guerra con %s"

#. kind: t
#. short caps label: keep <= 8 chars (glossary short form)
#: game/diplomacy.gd:1492 game/diplomacy.gd:1499
msgid "ПОМОЧЬ"
msgstr "AYUDAR"

#. kind: t
#. short caps label: keep <= 7 chars (glossary short form)
#: game/diplomacy.gd:1492
msgid "ОТКАЗ"
msgstr "RECHAZAR"

#. kind: t
#: game/diplomacy.gd:1497
msgid "НОТА ПРОТЕСТА: %s — нет помощи в войне с %s (%d из 3)"
msgstr "NOTA DE PROTESTA: %s — sin ayuda en la guerra con %s (%d de 3)"

#. kind: t
#. short caps label: keep <= 9 chars (glossary short form)
#: game/diplomacy.gd:1499
msgid "ПОНЯТНО"
msgstr "ENTENDIDO"

#. kind: t
#: game/diplomacy.gd:1531 game/diplomacy.gd:1556
msgid "Нужно от 500 денег"
msgstr "Hacen falta 500 de dinero o más"

#. kind: t
#: game/diplomacy.gd:1540
msgid "%s отказывается вступать в войну с %s"
msgstr "%s se niega a entrar en la guerra con %s"

#. kind: t
#: game/diplomacy.gd:1542
msgid "%s вступает в войну с %s по вашей просьбе"
msgstr "%s entra en la guerra con %s a petición tuya"

#. kind: t
#: game/diplomacy.gd:1544
msgid "%s не вступит в войну с %s, но прислал помощь"
msgstr "%s no entrará en la guerra con %s, pero envió ayuda"

#. kind: t
#: game/diplomacy.gd:1548
msgid "Призыв устарел"
msgstr "Llamada caducada"

#. kind: t
#: game/diplomacy.gd:1563 game/peace_conf.gd:655
msgid "Конференция закончилась"
msgstr "La conferencia terminó"

#. kind: t
#: game/econ_guide.gd:146
msgid " Не хватает: %s."
msgstr " Falta: %s."

#. kind: t
#: game/econ_guide.gd:263
msgid "Столица"
msgstr "Capital"

#. kind: t
#: game/econ_guide.gd:263
msgid "Тап по свободной земле: вырастет город, рядом сама встанет ТЭЦ и малые залежи руды."
msgstr "Toca tierra libre: crecerá una ciudad, y a su lado aparecerán una central térmica y pequeños yacimientos."

#. kind: t
#: game/econ_guide.gd:264
msgid "Столица основана"
msgstr "Capital fundada"

#. kind: t
#: game/econ_guide.gd:271
msgid "Колхоз: еда"
msgstr "Granja: comida"

#. kind: t
#: game/econ_guide.gd:271
msgid "Самый дешёвый доход: +%d еды и +%d денег в минуту. Еда кормит армию, излишки продаются."
msgstr "El ingreso más barato: +%d de comida y +%d de dinero por minuto. La comida alimenta al ejército; el excedente se vende."

#. kind: t
#: game/econ_guide.gd:272
msgid "Колхоз построен"
msgstr "Granja construida"

#. kind: t
#: game/econ_guide.gd:276
msgid "Завод товаров: деньги"
msgstr "Fábrica de bienes: dinero"

#. kind: t
#: game/econ_guide.gd:276
msgid "Главный доход: +%d денег в минуту и товары на продажу. Берёт 1 энергию — сеть сейчас %d/%d."
msgstr "Tu ingreso principal: +%d de dinero por minuto y bienes para vender. Usa 1 de energía — la red está en %d/%d."

#. kind: t
#: game/econ_guide.gd:277
msgid "Завод товаров работает"
msgstr "Fábrica de bienes en marcha"

#. kind: t
#: game/econ_guide.gd:280
msgid "Энергия: вторая станция"
msgstr "Energía: segunda central"

#. kind: t
#: game/econ_guide.gd:280
msgid "Каждый завод, рудник и НПЗ берёт 1 энергию, город 1–2. Сеть %d/%d — нужен запас: ТЭЦ +%d, солнечная станция +%d (дешевле)."
msgstr "Cada fábrica, mina y refinería usa 1 de energía, una ciudad 1–2. Red %d/%d — deja margen: central térmica +%d, planta solar +%d (más barata)."

#. kind: t
#: game/econ_guide.gd:281
msgid "Сеть усилена"
msgstr "Red reforzada"

#. kind: t
#: game/econ_guide.gd:286
msgid "Рудник: пропуск"
msgstr "Mina: omitir"

#. kind: t
#: game/econ_guide.gd:286
msgid "На вашей земле нет залежей руды: металл и титан — покупкой или новым городом."
msgstr "No hay yacimientos de mineral en tu tierra: consigue metal y titanio comprando o con una ciudad nueva."

#. kind: t
#: game/econ_guide.gd:294
msgid "Рудник: %s"
msgstr "Mina: %s"

#. kind: t
#: game/econ_guide.gd:294
msgid "Поставьте рудник прямо на значок залежи: +%d в минуту и +%d денег. %s"
msgstr "Pon una mina justo sobre el icono del yacimiento: +%d por minuto y +%d de dinero. %s"

#. kind: t
#: game/econ_guide.gd:295
msgid "Рудник работает"
msgstr "Mina en marcha"

#. kind: t
#: game/econ_guide.gd:298
msgid "Лесопилка: пропуск"
msgstr "Aserradero: omitir"

#. kind: t
#: game/econ_guide.gd:298
msgid "Рядом нет леса: дерево — покупкой."
msgstr "No hay bosque cerca: la madera, comprándola."

#. kind: t
#: game/econ_guide.gd:303
msgid "Лесопилка: дерево"
msgstr "Aserradero: madera"

#. kind: t
#: game/econ_guide.gd:303
msgid "Дерево нужно почти для всех построек (у вас %d). Лесопилка у леса даёт до +%d в минуту, лес отрастает."
msgstr "Casi todos los edificios necesitan madera (tienes %d). Un aserradero junto a un bosque da hasta +%d por minuto; el bosque vuelve a crecer."

#. kind: t
#: game/econ_guide.gd:304
msgid "Лесопилка работает"
msgstr "Aserradero en marcha"

#. kind: t
#: game/econ_guide.gd:310
msgid "Нефтевышка: пропуск"
msgstr "Torre petrolera: omitir"

#. kind: t
#: game/econ_guide.gd:310
msgid "На вашей земле нет нефти."
msgstr "No hay petróleo en tu tierra."

#. kind: t
#: game/econ_guide.gd:317
msgid "Нефтевышка: нефть"
msgstr "Torre petrolera: petróleo"

#. kind: t
#: game/econ_guide.gd:317
msgid "Нефть — сырьё для НПЗ. Вышка на чёрном значке залежи даёт +%d нефти в минуту."
msgstr "El petróleo alimenta la refinería. Una torre sobre el icono negro de yacimiento da +%d de petróleo por minuto."

#. kind: t
#: game/econ_guide.gd:318
msgid "Нефтевышка работает"
msgstr "Torre petrolera en marcha"

#. kind: t
#: game/econ_guide.gd:320
msgid "НПЗ: пропуск"
msgstr "Refinería: omitir"

#. kind: t
#: game/econ_guide.gd:320
msgid "Нет нефти — НПЗ не нужен."
msgstr "Sin petróleo no hace falta refinería."

#. kind: t
#: game/econ_guide.gd:326
msgid "НПЗ: топливо и деньги"
msgstr "Refinería: combustible y dinero"

#. kind: t
#: game/econ_guide.gd:326
msgid "Нефть → топливо (+%d в минуту на полной загрузке): излишки продаются сами, запас заправляет авиацию. На постройку нужна нефть %d."
msgstr "Petróleo → combustible (+%d por minuto a plena carga): el excedente se vende solo y la reserva abastece a la aviación. Construirla cuesta %d de petróleo."

#. kind: t
#: game/econ_guide.gd:327
msgid "НПЗ даёт топливо"
msgstr "La refinería produce combustible"

#. kind: t
#: game/econ_guide.gd:334
msgid " В вашем регионе нет: %s — это придётся покупать."
msgstr " No hay en tu región: %s — tendrás que comprarlo."

#. kind: t
#: game/econ_guide.gd:336
msgid "Порт: экспорт и импорт"
msgstr "Puerto: exportación e importación"

#. kind: t
#: game/econ_guide.gd:336
msgid "Порт сам вывозит излишки за рубеж, привозит нехватку и даёт +склад.%s"
msgstr "El puerto exporta el excedente por su cuenta, trae lo que falta y amplía el almacén.%s"

#. kind: t
#: game/econ_guide.gd:337
msgid "Порт построен"
msgstr "Puerto construido"

#. kind: t
#: game/econ_guide.gd:339
msgid "Торговля с соседом"
msgstr "Comercio con un vecino"

#. kind: t
#: game/econ_guide.gd:339
msgid "Выхода к морю нет: заключите торговое соглашение — излишки уйдут соседу сами, нехватку можно купить.%s"
msgstr "Sin salida al mar: firma un acuerdo comercial — el excedente irá al vecino solo y podrás comprar lo que falta.%s"

#. kind: t
#: game/econ_guide.gd:340
msgid "Торговля налажена"
msgstr "Comercio establecido"

#. kind: t
#: game/econ_guide.gd:341
msgid "Новый город"
msgstr "Ciudad nueva"

#. kind: t
#: game/econ_guide.gd:341
msgid "Город (%d) расширяет землю — новые залежи и лес, +%d денег в минуту. Ставьте рядом со значком руды."
msgstr "Una ciudad (%d) amplía tu tierra — nuevos yacimientos y bosque, +%d de dinero por minuto. Ponla junto a un icono de mineral."

#. kind: t
#: game/econ_guide.gd:342
msgid "Основан новый город"
msgstr "Nueva ciudad fundada"

#. kind: t
#: game/econ_guide.gd:346
msgid "Защита: казармы и ПВО"
msgstr "Defensa: cuartel y defensa aérea"

#. kind: t
#: game/econ_guide.gd:346
msgid "Казармы — армия до 12 бойцов, ПВО сбивает вражеские дроны. Боты начинают войну по выбору не раньше 10–12 минуты."
msgstr "El cuartel da un ejército de hasta 12 soldados; la defensa aérea derriba drones enemigos. Los bots no empiezan una guerra por elección antes del minuto 10–12."

#. kind: t
#: game/econ_guide.gd:347
msgid "Оборона готова"
msgstr "Defensa lista"

#. kind: mk
#: game/econ_guide.gd:377
msgid "План: %s +%d"
msgstr "Plan: %s +%d"

#. kind: t
#: game/econ_guide.gd:395
msgid "Окоп или блиндаж"
msgstr "Trinchera o refugio"

#. kind: t
#: game/econ_guide.gd:395
msgid "Ведите пальцем окоп у границы с соседом: пехота в укрытии получает втрое меньше урона, блиндаж ещё и лечит. Боты нападают с 10–12 минуты."
msgstr "Traza con el dedo una trinchera en la frontera: la infantería a cubierto recibe un tercio del daño, y el refugio además cura. Los bots atacan desde el minuto 10–12."

#. kind: t
#: game/econ_guide.gd:396
msgid "Рубеж обороны готов"
msgstr "Línea defensiva lista"

#. kind: t
#: game/econ_guide.gd:403
msgid "Улучшение: уровень 2"
msgstr "Mejora: nivel 2"

#. kind: t
#: game/econ_guide.gd:403
msgid "Улучшенный рудник, колхоз или завод даёт выпуск ×%.1f без новой энергии и места. Тап — к лучшему кандидату, кнопка «УР» в карточке."
msgstr "Una mina, granja o fábrica mejorada da ×%.1f de producción sin más energía ni espacio. Toca para ir al mejor candidato y luego el botón «NIV.» en su tarjeta."

#. kind: t
#: game/econ_guide.gd:404
msgid "Первое улучшение"
msgstr "Primera mejora"

#. kind: t
#: game/econ_guide.gd:408
msgid "Энергия: третья станция"
msgstr "Energía: tercera central"

#. kind: t
#: game/econ_guide.gd:408
msgid "Запас сети %d. Удар по ТЭЦ не должен гасить заводы, а новым заводам нужна энергия: ТЭЦ +%d или солнечная +%d."
msgstr "Margen de red: %d. Un ataque a una central no debe apagar tus fábricas, y las nuevas necesitan energía: central térmica +%d o solar +%d."

#. kind: t
#: game/econ_guide.gd:409
msgid "Сеть с запасом"
msgstr "Red con margen"

#. kind: t
#: game/econ_guide.gd:410
msgid "Третий город"
msgstr "Tercera ciudad"

#. kind: t
#: game/econ_guide.gd:410
msgid "+%d очков, +%d денег в минуту, новая земля и залежи. Ставьте у свободной залежи, пока её не занял сосед."
msgstr "+%d puntos, +%d de dinero por minuto, tierra y yacimientos nuevos. Ponla junto a un yacimiento libre antes de que lo tome un vecino."

#. kind: t
#: game/econ_guide.gd:411
msgid "Основан третий город"
msgstr "Tercera ciudad fundada"

#. kind: t
#: game/econ_guide.gd:413
msgid "Предприятия: %d/6"
msgstr "Empresas: %d/6"

#. kind: t
#: game/econ_guide.gd:413
msgid "Каждый колхоз, завод товаров, рудник или лесопилка — +25 очков и постоянный доход. Деньги на счету очков не дают."
msgstr "Cada granja, fábrica de bienes, mina o aserradero da +25 puntos e ingresos fijos. El dinero en la cuenta no da puntos."

#. kind: t
#: game/econ_guide.gd:414
msgid "Шесть предприятий"
msgstr "Seis empresas"

#. kind: t
#: game/econ_guide.gd:421
msgid "Договор: пропуск"
msgstr "Tratado: omitir"

#. kind: t
#: game/econ_guide.gd:421
msgid "Сейчас договор подписать не с кем."
msgstr "Ahora no hay con quién firmar un tratado."

#. kind: t
#: game/econ_guide.gd:423
msgid "Торговый договор"
msgstr "Tratado comercial"

#. kind: t
#: game/econ_guide.gd:423
msgid "Договор с соседом: излишки уходят ему сами (доход = очки), нехватку он продаёт дешевле, отношения растут — меньше ультиматумов."
msgstr "Un tratado con un vecino: el excedente va a él solo (ingresos = puntos), te vende lo que falta más barato y las relaciones mejoran — menos ultimátums."

#. kind: t
#: game/econ_guide.gd:424
msgid "Договор подписан"
msgstr "Tratado firmado"

#. kind: t
#: game/econ_guide.gd:434
msgid "Дроны: завод, дронопорт, рампа"
msgstr "Drones: fábrica, base, rampa"

#. kind: t
#: game/econ_guide.gd:434
msgid "Ударные дроны и разведдрон: завод дронов их делает, дронопорт хранит, с рампы они взлетают."
msgstr "Drones de ataque y de reconocimiento: la fábrica de drones los construye, la base de drones los guarda y despegan desde la rampa."

#. kind: t
#: game/econ_guide.gd:435
msgid "Дроны готовы к вылету"
msgstr "Drones listos para despegar"

#. kind: t
#: game/econ_guide.gd:449
msgid "Сетка: пропуск"
msgstr "Red antidrones: omitir"

#. kind: t
#: game/econ_guide.gd:449
msgid "Нет ТЭЦ или НПЗ, которые нужно прикрыть."
msgstr "No hay central térmica ni refinería que proteger."

#. kind: t
#: game/econ_guide.gd:451
msgid "Сетка над ТЭЦ"
msgstr "Red sobre la central"

#. kind: t
#: game/econ_guide.gd:451
msgid "ТЭЦ и НПЗ — первые цели вражеских дронов. Антидроновая сетка ловит 35–65 % ударных дронов (не ракеты)."
msgstr "Las centrales y refinerías son los primeros blancos de los drones enemigos. La red antidrones atrapa el 35–65 % — solo drones de ataque, no misiles."

#. kind: t
#: game/econ_guide.gd:452
msgid "Сетка натянута"
msgstr "Red instalada"

#. kind: t
#: game/econ_guide.gd:453
msgid "Улучшение: уровень 3"
msgstr "Mejora: nivel 3"

#. kind: t
#: game/econ_guide.gd:453
msgid "Уровень 3 — выпуск ×%.1f: больше дохода и очков с того же места. Тап — к объекту 2-го уровня, кнопка «УР»."
msgstr "Nivel 3 — producción ×%.1f: más ingresos y puntos en el mismo lugar. Toca para ir a una instalación de nivel 2 y luego el botón «NIV.»."

#. kind: t
#: game/econ_guide.gd:454
msgid "Первый объект 3-го уровня"
msgstr "Primera instalación de nivel 3"

#. kind: t
#: game/econ_guide.gd:455
msgid "Четвёртый город"
msgstr "Cuarta ciudad"

#. kind: t
#: game/econ_guide.gd:455
msgid "Ещё +%d очков и доход. Колония за морем тоже считается: порт → «КОЛОНИЯ»."
msgstr "Otros +%d puntos e ingresos. Una colonia de ultramar también cuenta: puerto → «COLONIA»."

#. kind: t
#: game/econ_guide.gd:456
msgid "Основан четвёртый город"
msgstr "Cuarta ciudad fundada"

#. kind: t
#: game/econ_guide.gd:457
msgid "Вторая армия"
msgstr "Segundo ejército"

#. kind: t
#: game/econ_guide.gd:457
msgid "Две полные казармы держат рубеж, пока вы отвечаете на удар. Режим «ОБОРОНА» — армия сама встаёт у городов."
msgstr "Dos cuarteles completos sostienen la línea mientras respondes al ataque. En modo «DEFENSA» el ejército se coloca solo junto a tus ciudades."

#. kind: t
#: game/econ_guide.gd:458
msgid "Две армии"
msgstr "Dos ejércitos"

#. kind: t
#: game/econ_guide.gd:465
msgid "покупка на рынке («КУПИТЬ НЕХВАТКУ»)"
msgstr "compra en el mercado («COMPRAR LO QUE FALTA»)"

#. kind: t
#: game/econ_guide.gd:468
msgid "улучшите свой титановый рудник"
msgstr "mejora tu mina de titanio"

#. kind: t
#: game/econ_guide.gd:471
msgid "рудник на голубой залежи"
msgstr "una mina en un yacimiento celeste"

#. kind: t
#: game/econ_guide.gd:473
msgid "рудник работает; быстрее — покупка"
msgstr "la mina funciona; más rápido — comprar"

#. kind: t
#: game/econ_guide.gd:474
msgid "Запас титана: 40"
msgstr "Reserva de titanio: 40"

#. kind: t
#: game/econ_guide.gd:474
msgid "Титан нужен ракетам, танкам и самолётам (у вас %d): %s."
msgstr "Los misiles, tanques y aviones necesitan titanio (tienes %d): %s."

#. kind: t
#: game/econ_guide.gd:475
msgid "Запас титана"
msgstr "Reserva de titanio"

#. kind: t
#: game/econ_guide.gd:477
msgid "Второй договор: пропуск"
msgstr "Segundo tratado: omitir"

#. kind: t
#: game/econ_guide.gd:477
msgid "Больше подписать не с кем."
msgstr "No queda nadie con quién firmar."

#. kind: t
#: game/econ_guide.gd:479
msgid "Второй договор"
msgstr "Segundo tratado"

#. kind: t
#: game/econ_guide.gd:479
msgid "Ещё один покупатель для излишков: торговля идёт в доход, доход — в очки."
msgstr "Otro comprador para tu excedente: el comercio da ingresos, y los ingresos, puntos."

#. kind: t
#: game/econ_guide.gd:480
msgid "Два торговых договора"
msgstr "Dos tratados comerciales"

#. kind: t
#: game/econ_guide.gd:481
msgid "Бетон над ТЭЦ"
msgstr "Hormigón sobre la central"

#. kind: t
#: game/econ_guide.gd:481
msgid "Бетон гасит крылатые и баллистические ракеты (сетка — нет). Потерянная ТЭЦ останавливает все заводы и доход."
msgstr "El hormigón detiene misiles de crucero y balísticos (la red no). Perder una central térmica para todas las fábricas y tus ingresos."

#. kind: t
#: game/econ_guide.gd:482
msgid "Бетон залит"
msgstr "Hormigón vertido"

#. kind: t
#: game/econ_guide.gd:483
msgid "Пятый город"
msgstr "Quinta ciudad"

#. kind: t
#: game/econ_guide.gd:483
msgid "Пять городов — заметный отрыв по очкам (+%d за город) и доходу."
msgstr "Cinco ciudades: una ventaja clara en puntos (+%d por ciudad) e ingresos."

#. kind: t
#: game/econ_guide.gd:484
msgid "Основан пятый город"
msgstr "Quinta ciudad fundada"

#. kind: t
#: game/econ_guide.gd:485
msgid "Предприятия: %d/10"
msgstr "Empresas: %d/10"

#. kind: t
#: game/econ_guide.gd:485
msgid "Десять предприятий — +250 очков и доход, который сам растит счёт."
msgstr "Diez empresas: +250 puntos e ingresos que hacen crecer tu marcador solos."

#. kind: t
#: game/econ_guide.gd:486
msgid "Десять предприятий"
msgstr "Diez empresas"

#. kind: t
#: game/econ_guide.gd:1122
msgid "Сеть %d/%d: свободно %d энергии (заводу, руднику, НПЗ нужно по 1)."
msgstr "Red %d/%d: %d de energía libre (cada fábrica, mina y refinería necesita 1)."

#. kind: t
#: game/econ_guide.gd:1127
msgid "зданий: %d"
msgstr "edificios: %d"

#. kind: t
#: game/econ_guide.gd:1129
msgid "городов: %d"
msgstr "ciudades: %d"

#. kind: t
#: game/econ_guide.gd:1130
msgid "Сеть перегружена %d/%d: без света %s — постройте ТЭЦ или солнечную станцию."
msgstr "Red sobrecargada %d/%d: sin luz %s — construye una central térmica o una planta solar."

#. kind: t
#: game/econ_guide.gd:1130
msgid "часть потребителей"
msgstr "parte de los consumidores"

#. kind: t
#: game/econ_guide.gd:1133
msgid "Сеть на пределе %d/%d: следующий завод останется без света — нужна ещё станция."
msgstr "Red al límite %d/%d: la próxima fábrica quedará sin luz — necesitas otra central."

#. kind: t
#: game/econ_guide.gd:1142
msgid "Еды хватает: +%d в минуту, армия ест %d."
msgstr "Comida suficiente: +%d por minuto, el ejército consume %d."

#. kind: t
#: game/econ_guide.gd:1149
msgid "Колхозов нет: еда понадобится армии, а колхоз ещё и приносит деньги."
msgstr "Sin granjas: el ejército necesitará comida, y la granja además da dinero."

#. kind: t
#: game/econ_guide.gd:1152
msgid "Армия голодает: еды нет — постройте колхоз или купите еду в торговле."
msgstr "El ejército pasa hambre: no hay comida — construye una granja o compra comida en el comercio."

#. kind: t
#: game/econ_guide.gd:1155
msgid "Колхозы на паузе — еда не растёт."
msgstr "Granjas en pausa — la comida no aumenta."

#. kind: t
#: game/econ_guide.gd:1158
msgid "Еда убывает (%d в минуту): запаса на ~%d мин — нужен ещё колхоз."
msgstr "La comida baja (%d por minuto): reserva para ~%d min — necesitas otra granja."

#. kind: t
#: game/econ_guide.gd:1160
msgid "Склад еды полон: излишки продаются за полцены."
msgstr "Almacén de comida lleno: el excedente se vende a mitad de precio."

#. kind: t
#: game/econ_guide.gd:1163
msgid "Колхоз → еда → армия"
msgstr "Granja → comida → ejército"

#. kind: t
#: game/econ_guide.gd:1170
msgid "ТЭЦ, АЭС и солнце → сеть"
msgstr "Central térmica, nuclear y solar → red"

#. kind: t
#: game/econ_guide.gd:1207
msgid "Урановая шахта → уран → АЭС"
msgstr "Mina de uranio → uranio → central nuclear"

#. kind: t
#: game/econ_guide.gd:1216
msgid "АЭС стоит без урана — купите уран в торговле или через порт%s."
msgstr "La central nuclear está parada sin uranio — compra uranio en el comercio o por un puerto%s."

#. kind: t
#: game/econ_guide.gd:1216
msgid ", или поставьте шахту на залежь"
msgstr ", o pon una mina en un yacimiento"

#. kind: t
#: game/econ_guide.gd:1220
msgid "Урана на %d мин работы АЭС — пополните запас."
msgstr "Uranio para %d min de la central nuclear — repón la reserva."

#. kind: t
#: game/econ_guide.gd:1223
msgid "На вашей земле залежь урана (зелёный значок): урановая шахта даёт топливо АЭС и дорогой товар."
msgstr "Hay un yacimiento de uranio en tu tierra (icono verde): la mina de uranio alimenta la central nuclear y da un bien valioso."

#. kind: t
#: game/econ_guide.gd:1227
msgid "Урана хватает на АЭС (%d): +%d энергии, но ей нужна ПВО."
msgstr "Uranio suficiente para la central nuclear (%d): +%d de energía, pero necesita defensa aérea."

#. kind: t
#: game/econ_guide.gd:1231
msgid "Уран %d%s."
msgstr "Uranio %d%s."

#. kind: t
#: game/econ_guide.gd:1231
msgid " · АЭС на %d мин"
msgstr " · central nuclear para %d min"

#. kind: t
#: game/econ_guide.gd:1231
msgid " · излишки дорого продаются"
msgstr " · el excedente se vende caro"

#. kind: t
#: game/econ_guide.gd:1263
msgid "Завод товаров → товары + деньги"
msgstr "Fábrica de bienes → bienes + dinero"

#. kind: t
#: game/econ_guide.gd:1276
msgid "Заводов товаров нет — это главный доход страны: +%d денег в минуту."
msgstr "No hay fábricas de bienes — son el principal ingreso del país: +%d de dinero por minuto."

#. kind: t
#: game/econ_guide.gd:1280
msgid "Завод товаров стоит без питания — постройте ТЭЦ или солнечную станцию."
msgstr "La fábrica de bienes no tiene energía — construye una central térmica o una planta solar."

#. kind: t
#: game/econ_guide.gd:1284
msgid "Завод товаров на паузе — денег не приносит."
msgstr "Fábrica de bienes en pausa — no da dinero."

#. kind: t
#: game/econ_guide.gd:1287
msgid "%d из %d заводов без питания — нужна ещё станция."
msgstr "%d de %d fábricas sin energía — necesitas otra central."

#. kind: t
#: game/econ_guide.gd:1291
msgid "Склад товаров полон: излишки уходят за полцены — продайте их или постройте порт."
msgstr "Almacén de bienes lleno: el excedente se va a mitad de precio — véndelo o construye un puerto."

#. kind: t
#: game/econ_guide.gd:1295
msgid "Работает: +%d денег в минуту."
msgstr "Funciona: +%d de dinero por minuto."

#. kind: t
#: game/econ_guide.gd:1313
msgid "Рудник → %s"
msgstr "Mina → %s"

#. kind: t
#: game/econ_guide.gd:1321
msgid "Не хватает: %s (%d) — %s."
msgstr "Falta: %s (%d) — %s."

#. kind: t
#: game/econ_guide.gd:1321
msgid "поставьте рудник на свободную залежь"
msgstr "pon una mina en un yacimiento libre"

#. kind: t
#: game/econ_guide.gd:1321
msgid "купите в торговле или через порт"
msgstr "compra en el comercio o por un puerto"

#. kind: t
#: game/econ_guide.gd:1324
msgid "На вашей земле свободная залежь: %s — поставьте на неё рудник."
msgstr "Hay un yacimiento libre en tu tierra: %s — pon una mina en él."

#. kind: t
#: game/econ_guide.gd:1327
msgid "В вашем регионе нет залежей: %s — покупайте в торговле или через порт."
msgstr "No hay yacimientos en tu región: %s — compra en el comercio o por un puerto."

#. kind: t
#: game/econ_guide.gd:1330
msgid "Рудника нет: ищите залежь (%s) у границ и основайте рядом город."
msgstr "Sin mina: busca un yacimiento (%s) cerca de tus fronteras y funda una ciudad al lado."

#. kind: t
#: game/econ_guide.gd:1356
msgid "Рудник стоит без питания — постройте ТЭЦ или солнечную станцию."
msgstr "La mina no tiene energía — construye una central térmica o una planta solar."

#. kind: t
#: game/econ_guide.gd:1360
msgid "Залежь исчерпана — поставьте рудник на другую залежь или покупайте %s."
msgstr "Yacimiento agotado — pon la mina en otro yacimiento o compra %s."

#. kind: t
#: game/econ_guide.gd:1364
msgid "Склад полон (%d) — продайте излишки в торговле или постройте порт."
msgstr "Almacén lleno (%d) — vende el excedente en el comercio o construye un puerto."

#. kind: t
#: game/econ_guide.gd:1368
msgid "Рудник на паузе — добычи нет."
msgstr "Mina en pausa — sin extracción."

#. kind: t
#: game/econ_guide.gd:1372
msgid "%d рудник(а) без питания — нужна ещё станция."
msgstr "%d mina(s) sin energía — necesitas otra central."

#. kind: t
#: game/econ_guide.gd:1376
msgid "Расход (%d) больше добычи (%d) — ещё рудник, улучшение или покупка."
msgstr "El consumo (%d) supera la extracción (%d) — otra mina, una mejora o compras."

#. kind: t
#: game/econ_guide.gd:1380
msgid "Залежь кончается: осталось %d — найдите новую."
msgstr "El yacimiento se agota: quedan %d — busca uno nuevo."

#. kind: t
#: game/econ_guide.gd:1384
msgid "Добыча +%d в минуту, запас %d."
msgstr "Extracción +%d por minuto, reserva %d."

#. kind: t
#: game/econ_guide.gd:1391
msgid "Лесопилка → дерево"
msgstr "Aserradero → madera"

#. kind: t
#: game/econ_guide.gd:1399
msgid "Лесопилки нет: дерево (у вас %d) нужно почти везде — ставьте у леса."
msgstr "Sin aserradero: la madera (tienes %d) se necesita casi para todo — ponlo junto a un bosque."

#. kind: t
#: game/econ_guide.gd:1421
msgid "Лес вокруг лесопилки вырублен — поставьте новую у леса (пни отрастают за 8 мин)."
msgstr "El bosque alrededor del aserradero está talado — pon uno nuevo junto a un bosque (los tocones rebrotan en 8 min)."

#. kind: t
#: game/econ_guide.gd:1421
msgid "Лес у лесопилки вырублен; дерева пока хватает (%d/%d). Новую лесопилку — у леса."
msgstr "El bosque junto al aserradero está talado; la madera alcanza por ahora (%d/%d). Pon un aserradero nuevo junto a un bosque."

#. kind: t
#: game/econ_guide.gd:1425
msgid "Склад дерева полон — продайте излишки."
msgstr "Almacén de madera lleno — vende el excedente."

#. kind: t
#: game/econ_guide.gd:1429
msgid "Лесопилка на паузе."
msgstr "Aserradero en pausa."

#. kind: t
#: game/econ_guide.gd:1432
msgid "Рубка +%d в минуту, запас %d."
msgstr "Tala +%d por minuto, reserva %d."

#. kind: t
#: game/econ_guide.gd:1441
msgid "Нефть → НПЗ → топливо"
msgstr "Petróleo → refinería → combustible"

#. kind: t
#: game/econ_guide.gd:1451
msgid "Нефтяная залежь на вашей земле: нефтевышка → НПЗ → топливо (продаётся само)."
msgstr "Yacimiento de petróleo en tu tierra: torre petrolera → refinería → combustible (se vende solo)."

#. kind: t
#: game/econ_guide.gd:1454
msgid "Нефти в вашем регионе нет: НПЗ возможен только на покупной нефти."
msgstr "No hay petróleo en tu región: la refinería solo puede funcionar con petróleo comprado."

#. kind: t
#: game/econ_guide.gd:1457
msgid "Нефти нет: ищите чёрный значок залежи у границ."
msgstr "Sin petróleo: busca el icono negro de yacimiento cerca de tus fronteras."

#. kind: t
#: game/econ_guide.gd:1462
msgid "Нефть копится (%d/%d): постройте НПЗ — топливо дороже сырой нефти."
msgstr "El petróleo se acumula (%d/%d): construye una refinería — el combustible vale más que el crudo."

#. kind: t
#: game/econ_guide.gd:1465
msgid "Нефть +%d в минуту. Дальше — НПЗ (на постройку нужна нефть 20)."
msgstr "Petróleo +%d por minuto. Lo siguiente: una refinería (construirla cuesta 20 de petróleo)."

#. kind: t
#: game/econ_guide.gd:1480
msgid "НПЗ стоит без питания — постройте ТЭЦ или солнечную станцию."
msgstr "La refinería no tiene energía — construye una central térmica o una planta solar."

#. kind: t
#: game/econ_guide.gd:1484
msgid "НПЗ на паузе."
msgstr "Refinería en pausa."

#. kind: t
#: game/econ_guide.gd:1487
msgid "НПЗ стоит: нет нефти — постройте нефтевышку или купите нефть."
msgstr "Refinería parada: sin petróleo — construye una torre petrolera o compra petróleo."

#. kind: t
#: game/econ_guide.gd:1491
msgid "Нефти мало: НПЗ может перерабатывать %d в минуту, вышки дают %d — ещё вышка или закупка."
msgstr "Poco petróleo: la refinería procesa %d por minuto, las torres dan %d — otra torre o compras."

#. kind: t
#: game/econ_guide.gd:1496
msgid "Топливо +%d в минуту, продажа излишков +%d денег."
msgstr "Combustible +%d por minuto, venta de excedente +%d de dinero."

#. kind: t
#: game/econ_guide.gd:1498
msgid "Топливо +%d в минуту копится в резерв авиации (%d), сверх него продаётся само."
msgstr "Combustible +%d por minuto va a la reserva de aviación (%d); lo demás se vende solo."

#. kind: t,table:LOC_TUT337_TITLES
#: game/econ_guide.gd:1510 ui/ui24/tutorial_feed.gd:34
msgid "Торговля и порт"
msgstr "Comercio y puertos"

#. kind: t
#: game/econ_guide.gd:1529
msgid "Продайте излишки: %s (склад полон)."
msgstr "Vende el excedente: %s (almacén lleno)."

#. kind: t
#: game/econ_guide.gd:1533 game/econ_guide.gd:1544
msgid "Не хватает: %s %d — купите в окне торговли."
msgstr "Falta: %s %d — cómpralo en la ventana de comercio."

#. kind: t
#: game/econ_guide.gd:1539
msgid "В вашем регионе нет: %s — это покупают. "
msgstr "No hay en tu región: %s — hay que comprarlo. "

#. kind: t
#: game/econ_guide.gd:1539
msgid "Договор с соседом сам продаёт излишки."
msgstr "Un tratado con un vecino vende el excedente automáticamente."

#. kind: t
#: game/econ_guide.gd:1548
msgid "Договоров: %d%s. Доход от торговли +%d в минуту."
msgstr "Tratados: %d%s. Ingresos por comercio +%d por minuto."

#. kind: t
#: game/econ_guide.gd:1548
msgid ", порт вывозит излишки"
msgstr ", el puerto exporta el excedente"

#. kind: t
#: game/econ_guide.gd:1557
msgid "Металл → дронный завод → дроны"
msgstr "Metal → fábrica de drones → drones"

#. kind: t
#: game/econ_guide.gd:1579
msgid "Дронный завод без питания — постройте ТЭЦ или солнечную станцию."
msgstr "La fábrica de drones no tiene energía — construye una central térmica o una planta solar."

#. kind: t
#: game/econ_guide.gd:1583
msgid "Дронный завод на паузе."
msgstr "Fábrica de drones en pausa."

#. kind: t
#: game/econ_guide.gd:1586
msgid "Дронам некуда садиться — постройте дронопорт."
msgstr "Los drones no tienen dónde aterrizar — construye una base de drones."

#. kind: t
#: game/econ_guide.gd:1590
msgid "Дронопорты полны (%d/%d): запускайте дроны или добавьте склад / дронопорт."
msgstr "Bases de drones llenas (%d/%d): lanza drones o añade un depósito / base de drones."

#. kind: t
#: game/econ_guide.gd:1594 game/econ_guide.gd:1644
msgid "Завод ждёт: не хватает %s — %s."
msgstr "Fábrica en espera: falta %s — %s."

#. kind: t
#: game/econ_guide.gd:1594
msgid "рудник на залежи металла или покупка"
msgstr "una mina en un yacimiento de metal, o cómpralo"

#. kind: t
#: game/econ_guide.gd:1594
msgid "нужны деньги"
msgstr "falta dinero"

#. kind: t
#: game/econ_guide.gd:1598
msgid "Дрон каждые %d с, в запасе %d/%d."
msgstr "Un dron cada %d s, en reserva %d/%d."

#. kind: t
#: game/econ_guide.gd:1607
msgid "Титан → ракетный завод → ракеты"
msgstr "Titanio → fábrica de misiles → misiles"

#. kind: t
#: game/econ_guide.gd:1624
msgid "Ракетный завод на паузе."
msgstr "Fábrica de misiles en pausa."

#. kind: t
#: game/econ_guide.gd:1628
msgid "Ракетный завод без питания — постройте ТЭЦ или солнечную станцию."
msgstr "La fábrica de misiles no tiene energía — construye una central térmica o una planta solar."

#. kind: t
#: game/econ_guide.gd:1635
msgid "Склад ракет (%s) полон: %d — запускайте или смените тип."
msgstr "Almacén de misiles (%s) lleno: %d — lánzalos o cambia el tipo."

#. kind: t
#: game/econ_guide.gd:1639
msgid "Ракетам (%s) нужен носитель — самолёт на аэродроме."
msgstr "Los misiles (%s) necesitan un portador — un avión en un aeródromo."

#. kind: t
#: game/econ_guide.gd:1644
msgid "рудник на залежи титана или покупка"
msgstr "una mina en un yacimiento de titanio, o cómpralo"

#. kind: t
#: game/econ_guide.gd:1644
msgid "добыча или покупка"
msgstr "extráelo o cómpralo"

#. kind: t
#: game/econ_guide.gd:1648
msgid "Работает: в запасе %d ракет."
msgstr "Funciona: %d misiles en reserva."

#. kind: t
#: game/econ_guide.gd:1675
msgid "Производство на паузе"
msgstr "Producción en pausa"

#. kind: t
#: game/econ_guide.gd:1679
msgid "Нет питания: постройте ТЭЦ или солнечную станцию"
msgstr "Sin energía: construye una central térmica o una planta solar"

#. kind: t
#: game/econ_guide.gd:1687
msgid "Залежь исчерпана — нужна новая"
msgstr "Yacimiento agotado — busca uno nuevo"

#. kind: t
#: game/econ_guide.gd:1691
msgid "Лес вокруг вырублен"
msgstr "El bosque de alrededor está talado"

#. kind: t
#: game/econ_guide.gd:1695
msgid "Склад полон: продайте излишки"
msgstr "Almacén lleno: vende el excedente"

#. kind: t
#: game/econ_guide.gd:1703
msgid "НПЗ стоит: нет нефти"
msgstr "Refinería parada: sin petróleo"

#. kind: t
#: game/econ_guide.gd:1710
msgid "Нужен дронопорт"
msgstr "Falta base de drones"

#. kind: t
#: game/econ_guide.gd:1714
msgid "Дронопорты полны"
msgstr "Bases de drones llenas"

