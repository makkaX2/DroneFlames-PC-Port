#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2128
msgid "объём"
msgstr "volumen"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2128
msgid "срок"
msgstr "plazo"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2176
msgid "Контракт предложен: ответ во «Входящих»"
msgstr "Contrato ofrecido: la respuesta llega a Entrada"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2186
msgid "ПРОСЯТ ВАС"
msgstr "TE PIDEN"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2186
msgid "ответьте до конца таймера"
msgstr "responde antes de que acabe el tiempo"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2193
msgid "ВЫ ПРОСИЛИ"
msgstr "PEDISTE"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2214
msgid "ПРАВО ПРОХОДА ЧЕРЕЗ НИХ"
msgstr "DERECHO DE PASO POR ELLOS"

#. cat=static zone=ui uses=2
#: ui/ui24/dip_page.gd:2214 ui/ui24/dip_page.gd:2218
msgid "ждёт ответа"
msgstr "esperando respuesta"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2218
msgid "ПРОХОД ЧЕРЕЗ НАС (предложили)"
msgstr "PASO POR NOSOTROS (ofrecido)"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2219
msgid "НОВАЯ ПРОСЬБА"
msgstr "PETICIÓN NUEVA"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2220
msgid "ПОПРОСИТЬ…"
msgstr "PEDIR…"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2230
msgid "Соперник: просьбы примет вряд ли — честно предупреждаем."
msgstr "Rival: es poco probable que acepte peticiones — te avisamos."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2294
msgid "Их ПВО встанут на вашей земле и будут сбивать ваших врагов."
msgstr "Su AA se desplegará en tu tierra y derribará a tus enemigos."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2300
msgid "Отказ — не война: дальше санкции на материал, затем полное эмбарго — до перемирия."
msgstr "Un rechazo no es guerra: luego sanciones a un material y después embargo total — hasta el alto el fuego."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2325
msgid "скорее да"
msgstr "probablemente sí"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2329
msgid "скорее нет"
msgstr "probablemente no"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2344
msgid "ЧТО ПОПРОСИТЬ"
msgstr "QUÉ PEDIR"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2344
msgid "ПРОВЕРИТЬ И ОТПРАВИТЬ"
msgstr "REVISAR Y ENVIAR"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2368
msgid "Объявить войну — кому?"
msgstr "Declarar la guerra — ¿a quién?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2368
msgid "Закрыть небо — над кем?"
msgstr "Cerrar el cielo — ¿sobre quién?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2368
msgid "Вступить в войну — против кого?"
msgstr "Entrar en la guerra — ¿contra quién?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2369
msgid "Прекратить войну — с кем?"
msgstr "Terminar la guerra — ¿con quién?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2369
msgid "Защищать их — от кого?"
msgstr "Defenderlos — ¿de quién?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2369
msgid "Кого?"
msgstr "¿A quién?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2388
msgid "нельзя: вы ни с кем не воюете"
msgstr "no se puede: no estás en guerra con nadie"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2406
msgid "выберите страну"
msgstr "elige un país"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2406
msgid "их ПВО прикроют выбранную страну"
msgstr "su AA cubrirá el país elegido"

#. cat=static zone=ui uses=2
#: ui/ui24/dip_page.gd:2406 ui/ui24/dip_page.gd:2406
msgid "выберите войну"
msgstr "elige una guerra"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2407
msgid "без войны · выберите их войну"
msgstr "sin guerra · elige su guerra"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2478
msgid "это вы"
msgstr "eres tú"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2487
msgid "ВОЙНА с вами"
msgstr "EN GUERRA contigo"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2490
msgid "ваш союзник"
msgstr "tu aliado"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2508
msgid "уже воюют · просить незачем"
msgstr "ya están en guerra · no hace falta pedir"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2627
msgid "ОТВЕТ"
msgstr "RESPUESTA"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:434
msgid "нет договоров"
msgstr "sin tratados"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:437
msgid "характер неизвестен"
msgstr "carácter desconocido"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:463
msgid "Нажмите на страну: договоры, война и мир"
msgstr "Toca un país: tratados, guerra y paz"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:539
msgid "Требует"
msgstr "Exige"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:557
msgid "Отказ →"
msgstr "Rechazo →"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:561
msgid "ваш пакт ненападения нарушат"
msgstr "romperán tu pacto de no agresión"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:607
msgid "предлагают пропуск через свою землю"
msgstr "ofrecen paso por su tierra"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:610
msgid "ПРОХОД?"
msgstr "¿PASO?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:623
msgid "ЗАКАЗ"
msgstr "PEDIDO"

#. cat=static zone=ui uses=2
#: ui/ui24/dip_sheet.gd:712 ui/ui24/inbox_sheet.gd:376
msgid "Обещание дано"
msgstr "Promesa hecha"

#. cat=static zone=ui uses=2
#: ui/ui24/dip_sheet.gd:712 ui/ui24/inbox_sheet.gd:376
msgid "Компенсация выплачена"
msgstr "Compensación pagada"

#. cat=static zone=ui uses=2
#: ui/ui24/dip_sheet.gd:712 ui/ui24/inbox_sheet.gd:376
msgid "Вступаем в войну"
msgstr "Entramos en la guerra"

#. cat=static zone=ui uses=2
#: ui/ui24/dip_sheet.gd:712 ui/ui24/inbox_sheet.gd:376
msgid "Помощь отправлена"
msgstr "Ayuda enviada"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:746
msgid "НЕНАПАД"
msgstr "NO AGRES."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:750
msgid "в союзе"
msgstr "aliados"

#. cat=formatted zone=ui uses=1
#: ui/ui24/dip_sheet.gd:794
msgid "%s уже входит в союз"
msgstr "%s ya forma parte de la alianza"

#. cat=formatted zone=ui uses=1
#: ui/ui24/dip_sheet.gd:803
