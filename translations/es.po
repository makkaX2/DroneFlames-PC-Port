msgstr "LLAMADA A LAS ARMAS"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:1803
msgid "КАПИТУЛЯЦИЯ"
msgstr "CAPITULACIÓN"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:1805
