msgstr "LIBERAR"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:1979
msgid "Отпущен: +20 к отношениям"
msgstr "Liberado: +20 a las relaciones"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:1983
msgid "СВОБОДА"
msgstr "LIBERTAD"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2019
msgid "Согласны: теперь это ваш вассал"
msgstr "Aceptan: ahora es tu vasallo"

#. cat=formatted zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2036
msgid "Сдались: теперь %s"
msgstr "Cedieron: ahora %s"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2163
msgid "нечего отправить"
msgstr "nada que enviar"

#. cat=formatted zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2209
msgid "Отправлено: %s ×%d — отношения растут"
msgstr "Enviado: %s ×%d — las relaciones mejoran"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2261
msgid "КАПИТУЛ.?"
msgstr "¿CAPITUL.?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2279
msgid "Капитуляция: земля поделена"
msgstr "Capitulación: tierra repartida"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2300
msgid "отказ → хуже отношения"
msgstr "rechazo → peores relaciones"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2300
msgid "отказ → требование"
msgstr "rechazo → exigencia"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2300
msgid "отказ → санкции, коалиция"
msgstr "rechazo → sanciones, coalición"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2300
msgid "отказ → ВОЙНА"
msgstr "rechazo → GUERRA"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2395
msgid "ТРЕБОВ."
msgstr "EXIGIR"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2395
msgid "УЛЬТИМ."
msgstr "ULTIM."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2424
msgid "НАПРЯЖЁННОСТЬ"
msgstr "TENSIÓN"

