msgstr "BLOQUE:"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2526
msgid "ЗНАК И НАЗВАНИЕ"
msgstr "EMBLEMA Y NOMBRE"

#. cat=formatted zone=ui uses=1
#: ui/ui24/dip_sheet.gd:2539
msgid "Вы вышли из альянса «%s»"
msgstr "Saliste del bloque «%s»"

#. cat=formatted zone=ui uses=1
