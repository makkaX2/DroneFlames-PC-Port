msgstr "%s: hacen falta relaciones de %d (ahora %d)"

#. cat=formatted zone=ui uses=1
#: ui/ui24/dip_sheet.gd:809
msgid "%s подписан"
msgstr "%s firmado"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:856
msgid "Отказ: перемирие им пока не нужно"
msgstr "Rechazo: aún no necesitan un alto el fuego"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:865
msgid "Отказ: мир им пока не нужен"
msgstr "Rechazo: aún no necesitan la paz"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:885
msgid "ВОЙНЫ"
msgstr "GUERRAS"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:899
msgid "Они воюют: удержите, чтобы объявить войну их врагу (+12 к отношениям с ними)"
msgstr "Están en guerra: mantén pulsado para declarar la guerra a su enemigo (+12 a las relaciones con ellos)"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:915
msgid "Без договора решают сами: отношения, характер, силы сторон и своя выгода"
msgstr "Sin tratado deciden por sí mismos: relaciones, carácter, fuerza de los bandos y su propio interés"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:948
msgid "ПОЗВАТЬ СОЮЗНИКОВ"
msgstr "LLAMAR A LOS ALIADOS"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:950
msgid "Некого звать: нет союзников и друзей (отношения от +30) вне этой войны"
msgstr "No hay a quién llamar: sin aliados ni amigos (relaciones desde +30) fuera de esta guerra"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:986
msgid "скорее согласится"
msgstr "probablemente acepte"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:1007
msgid "ПОЗВАТЬ"
msgstr "LLAMAR"

#. cat=formatted zone=ui uses=1
#: ui/ui24/dip_sheet.gd:1018
msgid "%s вступает в войну с %s"
msgstr "%s entra en la guerra con %s"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:1061
msgid "удерживайте"
msgstr "mantén pulsado"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:1803
