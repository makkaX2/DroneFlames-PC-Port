msgid "ЯДЕРНАЯ РАЗРЯДКА: {p0:name} И {p1:name} ОТВОДЯТ РАКЕТЫ"
msgstr "DISTENSIÓN NUCLEAR: {p0:name} Y {p1:name} RETIRAN SUS MISILES"

msgid "ПОРОГ ПРОЙДЕН: {p0:name} — НОВАЯ ЯДЕРНАЯ ДЕРЖАВА"
msgstr "UMBRAL CRUZADO: {p0:name} ES UNA NUEVA POTENCIA NUCLEAR"

msgid "ЯДЕРНЫЙ ПОРОГ ОБЕРНУЛСЯ ВОЙНОЙ: {p0:name} — {p1:name}"
msgstr "EL UMBRAL NUCLEAR ACABÓ EN GUERRA: {p0:name} — {p1:name}"

msgid "КРИЗИС ВОКРУГ ЯДЕРНОЙ ПРОГРАММЫ {p0:cgen} ИСЧЕРПАН"
msgstr "TERMINA LA CRISIS POR EL PROGRAMA NUCLEAR DE {p0:name}"

msgid "ЯДЕРНАЯ ГОНКА {p0:cgen} И {p1:cgen} ЗАКОНЧИЛАСЬ ВОЙНОЙ"
msgstr "LA CARRERA NUCLEAR DE {p0:name} Y {p1:name} ACABÓ EN GUERRA"

msgid "РАВНОВЕСИЕ СТРАХА: У {p0:cgen} И {p1:cgen} РАКЕТЫ И ПРО"
msgstr "EQUILIBRIO DEL TERROR: {p0:name} Y {p1:name} TIENEN MISILES Y ABM"

msgid "{p0:name} И {p1:name} СВОРАЧИВАЮТ ЯДЕРНУЮ ГОНКУ"
msgstr "{p0:name} Y {p1:name} FRENAN SU CARRERA NUCLEAR"

msgid "ЯДЕРНЫЙ КРИЗИС ВОКРУГ {p0:cgen} ИДЁТ НА СПАД"
msgstr "LA CRISIS NUCLEAR EN TORNO A {p0:name} REMITE"

msgid "ЯДЕРНОЕ ПРОТИВОСТОЯНИЕ: {p0:name} И {p1:name} ДЕРЖАТ ПАЛЕЦ НА КНОПКЕ"
msgstr "PULSO NUCLEAR: {p0:name} Y {p1:name} TIENEN EL DEDO EN EL BOTÓN"

msgid "{p0:name} ГРОЗИТ ОПЕРАЦИЕЙ ПРОТИВ ЯДЕРНОЙ ПРОГРАММЫ {p1:cgen}"
msgstr "{p0:name} AMENAZA CON UNA OPERACIÓN CONTRA EL PROGRAMA NUCLEAR DE {p1:name}"

msgid "%s грозит операцией против вашей ядерной программы"
msgstr "%s amenaza con una operación contra tu programa nuclear"

msgid "ЯДЕРНАЯ ГОНКА В РАЗГАРЕ: {p0:name} И {p1:name} — ШАХТ {p2}"
msgstr "LA CARRERA NUCLEAR SE ACELERA: {p0:name} Y {p1:name} — SILOS {p2}"

msgid "МИР ПРОТИВ ЯДЕРНОГО АГРЕССОРА: КОАЛИЦИЯ ПРОТИВ {p0:cgen}{p1}"
msgstr "EL MUNDO CONTRA EL AGRESOR NUCLEAR: COALICIÓN CONTRA {p0:name}{p1}"

msgid "После вашего ядерного удара мир объединяется против вас: санкции, ПРО, оборонные пакты"
msgstr "Tras tu ataque nuclear el mundo se une contra ti: sanciones, ABM, pactos de defensa"

msgid "ВОЙНА В ТЕНИ РАКЕТ: {p0:name} (БЛОК {p1:cgen}) — {p2:name}"
msgstr "GUERRA A LA SOMBRA DE LOS MISILES: {p0:name} (BLOQUE DE {p1:name}) — {p2:name}"

msgid "НОВЫЙ ЯДЕРНЫЙ УДАР {p0:cgen}: КРИЗИС УГЛУБЛЯЕТСЯ"
msgstr "OTRO ATAQUE NUCLEAR DE {p0:name}: LA CRISIS SE AGRAVA"

# R383 WHATS_NEW
msgid "Ядерное оружие — шахты, ракеты, ПРО; удар можно нанести по любой стране, сам пуск объявляет войну, ПРО цели сбивает ракеты и без войны"
msgstr "Armas nucleares — silos, misiles, ABM; puedes atacar a cualquier país, el lanzamiento declara la guerra, el ABM del objetivo derriba misiles incluso sin guerra"

# R383 WHATS_NEW
msgid "Ответный удар — в карточке шахты назначьте цели на карте: если по вам пустят ракету, ваши шахты ответят сами"
msgstr "Represalia — fija objetivos en el mapa desde la ficha del silo: si te lanzan un misil, tus silos responden solos"

# R383 WHATS_NEW
msgid "Ядерная тревога — при взлёте любой ядерной ракеты все страны видят тревогу и красную рамку"
msgstr "Alerta nuclear — cuando despega cualquier misil nuclear, todos los países ven la alerta y un marco rojo"

# R383 WHATS_NEW
msgid "Последствия удара на карте — выжженная пустошь с пнями, щебнем и сгоревшими машинами, тлеющие руины; пустошь медленно зарастает, у воронки остаётся шрам"
msgstr "Secuelas del ataque en el mapa — un páramo calcinado con tocones, escombros y coches quemados, ruinas humeantes; vuelve a crecer despacio, junto al cráter queda una cicatriz"

# R383 WHATS_NEW
msgid "Живой мир — новые сюжеты: ядерная холодная война, ядерный порог, гонка вооружений, кризис после удара"
msgstr "Mundo vivo — nuevas historias: guerra fría nuclear, umbral nuclear, carrera armamentística, crisis tras un ataque"

# R383 WHATS_NEW
msgid "Авианосцы и воздушный десант — авианосец выбирается тапом по всему корпусу, боты чаще строят авиабазы и высаживают десант"
msgstr "Portaaviones y desembarco aéreo — toca cualquier parte del casco para elegir el portaaviones, los bots construyen más bases aéreas y desembarcan tropas"

# R383 WHATS_NEW
msgid "Интерфейс — окно страны при войне на всю высоту, окно торговли просторнее, ничего не мигает, имена стран в хронике как на карте"
msgstr "Interfaz — la ventana del país en guerra ocupa toda la altura, la de comercio es más amplia, nada parpadea, los nombres en la crónica coinciden con el mapa"

# R383 WHATS_NEW
msgid "Исправлено: огни вокзалов и высоток сквозь туман войны, огни самолётов над палубой, десант «пропадал» у ворот авиабазы, карточка АЭС закрывала цену"
msgstr "Corregido: luces de estaciones y torres a través de la niebla de guerra, luces de aviones sobre la cubierta, tropas aerotransportadas que «desaparecían» en la puerta de la base, la ficha de la central tapaba el precio"

# R384 NUKEAI2
msgid "ПОСЛЕДНЕЕ ПРЕДУПРЕЖДЕНИЕ: %s нанесёт ядерный удар через %d с, если ваши войска не отойдут. Перемирие остановит удар"
msgstr "ÚLTIMO AVISO: %s lanzará un ataque nuclear en %d s si tus tropas no se retiran. Una tregua detiene el ataque"

msgid "%s: ПОСЛЕДНЕЕ ПРЕДУПРЕЖДЕНИЕ %s — ЯДЕРНЫЙ УДАР ЧЕРЕЗ МИНУТУ"
msgstr "%s: ÚLTIMO AVISO A %s — ATAQUE NUCLEAR EN UN MINUTO"

msgid "%s ПЕРВОЙ ПРИМЕНЯЕТ ЯДЕРНОЕ ОРУЖИЕ ПРОТИВ %s: ВОЙНА ПРОИГРЫВАЕТСЯ"
msgstr "%s ES LA PRIMERA EN USAR ARMAS NUCLEARES CONTRA %s: ESTÁ PERDIENDO LA GUERRA"

msgid "%s ПРИМЕНЯЕТ ЯДЕРНОЕ ОРУЖИЕ ПРОТИВ %s: «УГРОЗА СУЩЕСТВОВАНИЮ СТРАНЫ»"
msgstr "%s USA ARMAS NUCLEARES CONTRA %s: «UNA AMENAZA A LA EXISTENCIA DEL PAÍS»"

msgid "%s ГРОЗИТ %s ЯДЕРНЫМ УДАРОМ: УЛЬТИМАТУМ"
msgstr "%s AMENAZA A %s CON UN ATAQUE NUCLEAR: ULTIMÁTUM"

msgid "%s ГРОЗИТ %s ЯДЕРНЫМ УДАРОМ: ШАХТЫ ОТКРЫТЫ"
msgstr "%s AMENAZA A %s CON UN ATAQUE NUCLEAR: SILOS ABIERTOS"

msgid "%s ПРОВОДИТ ЯДЕРНЫЕ УЧЕНИЯ У ГРАНИЦ %s: ШАХТЫ ОТКРЫТЫ"
msgstr "%s REALIZA MANIOBRAS NUCLEARES CERCA DE LAS FRONTERAS DE %s: SILOS ABIERTOS"

msgid "%s ПРОСИТ ПЕРЕМИРИЯ ПОД ЯДЕРНОЙ УГРОЗОЙ %s"
msgstr "%s PIDE UNA TREGUA BAJO LA AMENAZA NUCLEAR DE %s"

# R384 AIDYN: a bot prepares a war (ai_dyn.cpp _dyn_news)
msgid "%s ГОТОВИТСЯ К ВОЙНЕ: СТЯГИВАЕТ ФЛОТ (ЦЕЛЬ — %s)"
msgstr "%s SE PREPARA PARA LA GUERRA: CONCENTRA SU FLOTA (OBJETIVO: %s)"

msgid "%s ГОТОВИТСЯ К ВОЙНЕ: ГОТОВИТ ДЕСАНТ (ЦЕЛЬ — %s)"
msgstr "%s SE PREPARA PARA LA GUERRA: PREPARA UN DESEMBARCO AÉREO (OBJETIVO: %s)"

msgid "%s ГОТОВИТСЯ К ВОЙНЕ: СТЯГИВАЕТ ВОЙСКА К ГРАНИЦЕ (ЦЕЛЬ — %s)"
msgstr "%s SE PREPARA PARA LA GUERRA: CONCENTRA TROPAS EN LA FRONTERA (OBJETIVO: %s)"

# R384 WHATS_NEW
msgid "Боты развиваются от ситуации — готовясь к войне, заранее строят флот, десант, армию у границы или ПВО и ПРО против угроз; в хронике видно, кто к чему готовится"
msgstr "Los bots se desarrollan según la situación — al preparar una guerra construyen de antemano flota, desembarco aéreo, ejército en la frontera o defensa aérea y antimisiles; la crónica muestra quién se prepara para qué"

# R384 WHATS_NEW
msgid "Ядерное поведение ботов — державы угрожают друг другу ультиматумами и тревогами, изредка наносят удар; по игроку — только если он угрожает существованию страны, и после явного предупреждения; на ядерный удар всегда летит ответ"
msgstr "Conducta nuclear de los bots — las potencias se amenazan con ultimátums y alertas y a veces atacan; al jugador solo si amenaza la existencia del país y tras un aviso claro; un ataque nuclear siempre recibe respuesta"

