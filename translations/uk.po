#. kind: t
#: game/diplomacy.gd:1313 game/diplomacy.gd:1282
msgid "выбирает сторону: вы или %s — ещё %d с"
msgstr "обирає бік: ви або %s — ще %d с"

#. kind: t
#: game/diplomacy.gd:1323 game/diplomacy.gd:1292
msgid "игрок — ответит сам"
msgstr "гравець — відповість сам"

#. kind: t
#: game/diplomacy.gd:1333 game/diplomacy.gd:1302
msgid "воюет за свою жизнь"
msgstr "воює за своє життя"

#. kind: t
#: game/diplomacy.gd:1333 game/diplomacy.gd:1302
msgid "уже две войны"
msgstr "уже дві війни"

#. kind: mk
#: game/diplomacy.gd:1433 game/diplomacy.gd:1402
msgid "%s предлагает вам вступить в войну с %s"
msgstr "%s пропонує вам вступити у війну з %s"

#. kind: mk
#: game/diplomacy.gd:1456 game/diplomacy.gd:1425
msgid "Вы не ответили на призыв %s"
msgstr "Ви не відповіли на заклик %s"

#. kind: mk
#: game/diplomacy.gd:1459 game/diplomacy.gd:1428
msgid "%s не ответил на просьбу о войне с %s"
msgstr "%s не відповів на прохання про війну з %s"

#. kind: t
#: game/diplomacy.gd:1490 game/diplomacy.gd:1459
msgid "%s предлагает вступить в войну с %s"
msgstr "%s пропонує вступити у війну з %s"

#. kind: t
#: game/diplomacy.gd:1490 game/diplomacy.gd:1459
msgid "%s призывает к войне с %s"
msgstr "%s закликає до війни з %s"

#. kind: t
#. short caps label: keep <= 8 chars (glossary short form)
#: game/diplomacy.gd:1492 game/diplomacy.gd:1499 game/diplomacy.gd:1461 game/diplomacy.gd:1468
msgid "ПОМОЧЬ"
msgstr "ДОПОМОГТИ"

#. kind: t
#. short caps label: keep <= 7 chars (glossary short form)
#: game/diplomacy.gd:1492 game/diplomacy.gd:1461
msgid "ОТКАЗ"
msgstr "ВІДМОВА"

#. kind: t
#: game/diplomacy.gd:1497 game/diplomacy.gd:1466
msgid "НОТА ПРОТЕСТА: %s — нет помощи в войне с %s (%d из 3)"
msgstr "НОТА ПРОТЕСТУ: %s — немає допомоги у війні з %s (%d з 3)"

#. kind: t
#. short caps label: keep <= 9 chars (glossary short form)
#: game/diplomacy.gd:1499 game/diplomacy.gd:1468 ui/menus.gd:1161 ui/ui24/help_tips.gd:161
msgid "ПОНЯТНО"
msgstr "ЗРОЗУМІЛО"

#. kind: t
#: game/diplomacy.gd:1531 game/diplomacy.gd:1556 game/diplomacy.gd:1500 game/diplomacy.gd:1525
msgid "Нужно от 500 денег"
msgstr "Потрібно від 500 грошей"

#. kind: t
#: game/diplomacy.gd:1540 game/diplomacy.gd:1509
msgid "%s отказывается вступать в войну с %s"
msgstr "%s відмовляється вступати у війну з %s"

#. kind: t
#: game/diplomacy.gd:1542 game/diplomacy.gd:1511
msgid "%s вступает в войну с %s по вашей просьбе"
msgstr "%s вступає у війну з %s на ваше прохання"

#. kind: t
#: game/diplomacy.gd:1544 game/diplomacy.gd:1513
msgid "%s не вступит в войну с %s, но прислал помощь"
msgstr "%s не вступить у війну з %s, але надіслав допомогу"

#. kind: t
#: game/diplomacy.gd:1548 game/diplomacy.gd:1517
msgid "Призыв устарел"
msgstr "Заклик застарів"

#. kind: t
#: game/diplomacy.gd:1563 game/peace_conf.gd:655 game/diplomacy.gd:1532
#: ui/ui24/conference_sheet.gd:1258 ui/ui24/dip_sheet.gd:2288
msgid "Конференция закончилась"
msgstr "Конференція завершилася"

#. kind: t
#: game/econ_guide.gd:146
msgid " Не хватает: %s."
msgstr " Бракує: %s."

#. kind: t
#: game/econ_guide.gd:263 ui/hud/hud_cards.gd:798
msgid "Столица"
msgstr "Столиця"

#. kind: t
#: game/econ_guide.gd:263
msgid "Тап по свободной земле: вырастет город, рядом сама встанет ТЭЦ и малые залежи руды."
msgstr "Торкніться вільної землі: виросте місто, поруч сама стане ТЕЦ і малі поклади руди."

#. kind: t
#: game/econ_guide.gd:264
msgid "Столица основана"
msgstr "Столицю засновано"

#. kind: t
#: game/econ_guide.gd:271
msgid "Колхоз: еда"
msgstr "Ферма: їжа"

#. kind: t
#: game/econ_guide.gd:271
msgid "Самый дешёвый доход: +%d еды и +%d денег в минуту. Еда кормит армию, излишки продаются."
msgstr "Найдешевший дохід: +%d їжі і +%d грошей за хвилину. Їжа годує армію, надлишки продаються."

#. kind: t
#: game/econ_guide.gd:272
msgid "Колхоз построен"
msgstr "Ферму збудовано"

#. kind: t
#: game/econ_guide.gd:276
msgid "Завод товаров: деньги"
msgstr "Завод товарів: гроші"

#. kind: t
#: game/econ_guide.gd:276
msgid "Главный доход: +%d денег в минуту и товары на продажу. Берёт 1 энергию — сеть сейчас %d/%d."
msgstr "Головний дохід: +%d грошей за хвилину і товари на продаж. Бере 1 енергію — мережа зараз %d/%d."

#. kind: t
#: game/econ_guide.gd:277
msgid "Завод товаров работает"
msgstr "Завод товарів працює"

#. kind: t
#: game/econ_guide.gd:280
msgid "Энергия: вторая станция"
msgstr "Енергія: друга станція"

#. kind: t
#: game/econ_guide.gd:280
msgid "Каждый завод, рудник и НПЗ берёт 1 энергию, город 1–2. Сеть %d/%d — нужен запас: ТЭЦ +%d, солнечная станция +%d (дешевле)."
msgstr "Кожен завод, рудник і НПЗ бере 1 енергію, місто 1–2. Мережа %d/%d — потрібен запас: ТЕЦ +%d, сонячна станція +%d (дешевше)."

#. kind: t
#: game/econ_guide.gd:281
msgid "Сеть усилена"
msgstr "Мережу посилено"

#. kind: t
#: game/econ_guide.gd:286
msgid "Рудник: пропуск"
msgstr "Рудник: пропуск"

#. kind: t
#: game/econ_guide.gd:286
msgid "На вашей земле нет залежей руды: металл и титан — покупкой или новым городом."
msgstr "На вашій землі немає покладів руди: метал і титан — купівлею або новим містом."

#. kind: t
#: game/econ_guide.gd:294
msgid "Рудник: %s"
msgstr "Рудник: %s"

#. kind: t
#: game/econ_guide.gd:294
msgid "Поставьте рудник прямо на значок залежи: +%d в минуту и +%d денег. %s"
msgstr "Поставте рудник просто на значок покладу: +%d за хвилину і +%d грошей. %s"

#. kind: t
#: game/econ_guide.gd:295
msgid "Рудник работает"
msgstr "Рудник працює"

#. kind: t
#: game/econ_guide.gd:298
msgid "Лесопилка: пропуск"
msgstr "Лісопилка: пропуск"

#. kind: t
#: game/econ_guide.gd:298
msgid "Рядом нет леса: дерево — покупкой."
msgstr "Поруч немає лісу: деревина — купівлею."

#. kind: t
#: game/econ_guide.gd:303
msgid "Лесопилка: дерево"
msgstr "Лісопилка: деревина"

#. kind: t
#: game/econ_guide.gd:303
msgid "Дерево нужно почти для всех построек (у вас %d). Лесопилка у леса даёт до +%d в минуту, лес отрастает."
msgstr "Деревина потрібна майже для всіх будівель (у вас %d). Лісопилка біля лісу дає до +%d за хвилину, ліс відростає."

#. kind: t
#: game/econ_guide.gd:304
msgid "Лесопилка работает"
msgstr "Лісопилка працює"

#. kind: t
#: game/econ_guide.gd:310
msgid "Нефтевышка: пропуск"
msgstr "Нафтова вишка: пропуск"

#. kind: t
#: game/econ_guide.gd:310
msgid "На вашей земле нет нефти."
msgstr "На вашій землі немає нафти."

#. kind: t
#: game/econ_guide.gd:317
msgid "Нефтевышка: нефть"
msgstr "Нафтова вишка: нафта"

#. kind: t
#: game/econ_guide.gd:317
msgid "Нефть — сырьё для НПЗ. Вышка на чёрном значке залежи даёт +%d нефти в минуту."
msgstr "Нафта — сировина для НПЗ. Вишка на чорному значку покладу дає +%d нафти за хвилину."

#. kind: t
#: game/econ_guide.gd:318
msgid "Нефтевышка работает"
msgstr "Нафтова вишка працює"

#. kind: t
#: game/econ_guide.gd:320
msgid "НПЗ: пропуск"
msgstr "НПЗ: пропуск"

#. kind: t
#: game/econ_guide.gd:320
msgid "Нет нефти — НПЗ не нужен."
msgstr "Немає нафти — НПЗ не потрібен."

#. kind: t
#: game/econ_guide.gd:326
msgid "НПЗ: топливо и деньги"
msgstr "НПЗ: пальне і гроші"

#. kind: t
#: game/econ_guide.gd:326
msgid "Нефть → топливо (+%d в минуту на полной загрузке): излишки продаются сами, запас заправляет авиацию. На постройку нужна нефть %d."
msgstr "Нафта → пальне (+%d за хвилину на повному завантаженні): надлишки продаються самі, запас заправляє авіацію. На будівництво потрібна нафта %d."

#. kind: t
#: game/econ_guide.gd:327
msgid "НПЗ даёт топливо"
msgstr "НПЗ дає пальне"

#. kind: t
#: game/econ_guide.gd:334
msgid " В вашем регионе нет: %s — это придётся покупать."
msgstr " У вашому регіоні немає: %s — це доведеться купувати."

#. kind: t
#: game/econ_guide.gd:336
msgid "Порт: экспорт и импорт"
msgstr "Порт: експорт та імпорт"

#. kind: t
#: game/econ_guide.gd:336
msgid "Порт сам вывозит излишки за рубеж, привозит нехватку и даёт +склад.%s"
msgstr "Порт сам вивозить надлишки за кордон, привозить те, чого бракує, і дає +склад.%s"

#. kind: t
#: game/econ_guide.gd:337
msgid "Порт построен"
msgstr "Порт збудовано"

#. kind: t
#: game/econ_guide.gd:339
msgid "Торговля с соседом"
msgstr "Торгівля із сусідом"

#. kind: t
#: game/econ_guide.gd:339
msgid "Выхода к морю нет: заключите торговое соглашение — излишки уйдут соседу сами, нехватку можно купить.%s"
msgstr "Виходу до моря немає: укладіть торгову угоду — надлишки підуть сусідові самі, те, чого бракує, можна купити.%s"

#. kind: t
#: game/econ_guide.gd:340
msgid "Торговля налажена"
msgstr "Торгівлю налагоджено"

#. kind: t
#: game/econ_guide.gd:341 ui/hud/hud_base.gd:235
msgid "Новый город"
msgstr "Нове місто"

#. kind: t
#: game/econ_guide.gd:341
msgid "Город (%d) расширяет землю — новые залежи и лес, +%d денег в минуту. Ставьте рядом со значком руды."
msgstr "Місто (%d) розширює землю — нові поклади й ліс, +%d грошей за хвилину. Ставте поруч зі значком руди."

#. kind: t
#: game/econ_guide.gd:342
msgid "Основан новый город"
msgstr "Засновано нове місто"

#. kind: t
#: game/econ_guide.gd:346
msgid "Защита: казармы и ПВО"
msgstr "Захист: казарми і ППО"

#. kind: t
#: game/econ_guide.gd:346
msgid "Казармы — армия до 12 бойцов, ПВО сбивает вражеские дроны. Боты начинают войну по выбору не раньше 10–12 минуты."
msgstr "Казарми — армія до 12 бійців, ППО збиває ворожі дрони. Боти починають війну на власний вибір не раніше 10–12 хвилини."

#. kind: t
#: game/econ_guide.gd:347
msgid "Оборона готова"
msgstr "Оборона готова"

#. kind: mk
#: game/econ_guide.gd:377
msgid "План: %s +%d"
msgstr "План: %s +%d"

#. kind: t
#: game/econ_guide.gd:395
msgid "Окоп или блиндаж"
msgstr "Окоп або бліндаж"

#. kind: t
#: game/econ_guide.gd:395
msgid "Ведите пальцем окоп у границы с соседом: пехота в укрытии получает втрое меньше урона, блиндаж ещё и лечит. Боты нападают с 10–12 минуты."
msgstr "Ведіть пальцем окоп біля кордону із сусідом: піхота в укритті отримує втричі менше шкоди, бліндаж ще й лікує. Боти нападають з 10–12 хвилини."

#. kind: t
#: game/econ_guide.gd:396
msgid "Рубеж обороны готов"
msgstr "Рубіж оборони готовий"

#. kind: t
#: game/econ_guide.gd:403
msgid "Улучшение: уровень 2"
msgstr "Покращення: рівень 2"

#. kind: t
#: game/econ_guide.gd:403
msgid "Улучшенный рудник, колхоз или завод даёт выпуск ×%.1f без новой энергии и места. Тап — к лучшему кандидату, кнопка «УР» в карточке."
msgstr "Покращений рудник, ферма або завод дає випуск ×%.1f без нової енергії і місця. Торкніться — до найкращого кандидата, кнопка «РІВ» у картці."

#. kind: t
#: game/econ_guide.gd:404
msgid "Первое улучшение"
msgstr "Перше покращення"

#. kind: t
#: game/econ_guide.gd:408
msgid "Энергия: третья станция"
msgstr "Енергія: третя станція"

#. kind: t
#: game/econ_guide.gd:408
msgid "Запас сети %d. Удар по ТЭЦ не должен гасить заводы, а новым заводам нужна энергия: ТЭЦ +%d или солнечная +%d."
msgstr "Запас мережі %d. Удар по ТЕЦ не має гасити заводи, а новим заводам потрібна енергія: ТЕЦ +%d або сонячна +%d."

#. kind: t
#: game/econ_guide.gd:409
msgid "Сеть с запасом"
msgstr "Мережа із запасом"

#. kind: t
#: game/econ_guide.gd:410
msgid "Третий город"
msgstr "Третє місто"

#. kind: t
#: game/econ_guide.gd:410
msgid "+%d очков, +%d денег в минуту, новая земля и залежи. Ставьте у свободной залежи, пока её не занял сосед."
msgstr "+%d очок, +%d грошей за хвилину, нова земля й поклади. Ставте біля вільного покладу, поки його не зайняв сусід."

#. kind: t
#: game/econ_guide.gd:411
msgid "Основан третий город"
msgstr "Засновано третє місто"

#. kind: t
#: game/econ_guide.gd:413
msgid "Предприятия: %d/6"
msgstr "Підприємства: %d/6"

#. kind: t
#: game/econ_guide.gd:413
msgid "Каждый колхоз, завод товаров, рудник или лесопилка — +25 очков и постоянный доход. Деньги на счету очков не дают."
msgstr "Кожна ферма, завод товарів, рудник або лісопилка — +25 очок і постійний дохід. Гроші на рахунку очок не дають."

#. kind: t
#: game/econ_guide.gd:414
msgid "Шесть предприятий"
msgstr "Шість підприємств"

#. kind: t
#: game/econ_guide.gd:421
msgid "Договор: пропуск"
msgstr "Договір: пропуск"

#. kind: t
#: game/econ_guide.gd:421
msgid "Сейчас договор подписать не с кем."
msgstr "Зараз договір підписати ні з ким."

#. kind: t
#: game/econ_guide.gd:423
msgid "Торговый договор"
msgstr "Торговий договір"

#. kind: t
#: game/econ_guide.gd:423
msgid "Договор с соседом: излишки уходят ему сами (доход = очки), нехватку он продаёт дешевле, отношения растут — меньше ультиматумов."
msgstr "Договір із сусідом: надлишки йдуть йому самі (дохід = очки), те, чого бракує, він продає дешевше, відносини ростуть — менше ультиматумів."

#. kind: t
#: game/econ_guide.gd:424
msgid "Договор подписан"
msgstr "Договір підписано"

#. kind: t
#: game/econ_guide.gd:434
msgid "Дроны: завод, дронопорт, рампа"
msgstr "Дрони: завод, дронопорт, рампа"

#. kind: t
#: game/econ_guide.gd:434
msgid "Ударные дроны и разведдрон: завод дронов их делает, дронопорт хранит, с рампы они взлетают."
msgstr "Ударні дрони й дрон-розвідник: завод дронів їх робить, дронопорт зберігає, з рампи вони злітають."

#. kind: t
#: game/econ_guide.gd:435
msgid "Дроны готовы к вылету"
msgstr "Дрони готові до вильоту"

#. kind: t
#: game/econ_guide.gd:449
msgid "Сетка: пропуск"
msgstr "Сітка: пропуск"

#. kind: t
#: game/econ_guide.gd:449
msgid "Нет ТЭЦ или НПЗ, которые нужно прикрыть."
msgstr "Немає ТЕЦ або НПЗ, які треба прикрити."

#. kind: t
#: game/econ_guide.gd:451
msgid "Сетка над ТЭЦ"
msgstr "Сітка над ТЕЦ"

#. kind: t
#: game/econ_guide.gd:451
msgid "ТЭЦ и НПЗ — первые цели вражеских дронов. Антидроновая сетка ловит 35–65 % ударных дронов (не ракеты)."
msgstr "ТЕЦ і НПЗ — перші цілі ворожих дронів. Протидронова сітка ловить 35–65 % ударних дронів (не ракети)."

#. kind: t
#: game/econ_guide.gd:452
msgid "Сетка натянута"
msgstr "Сітку натягнуто"

#. kind: t
#: game/econ_guide.gd:453
msgid "Улучшение: уровень 3"
msgstr "Покращення: рівень 3"

#. kind: t
#: game/econ_guide.gd:453
msgid "Уровень 3 — выпуск ×%.1f: больше дохода и очков с того же места. Тап — к объекту 2-го уровня, кнопка «УР»."
msgstr "Рівень 3 — випуск ×%.1f: більше доходу й очок з того самого місця. Торкніться — до об’єкта 2-го рівня, кнопка «РІВ»."

#. kind: t
#: game/econ_guide.gd:454
msgid "Первый объект 3-го уровня"
msgstr "Перший об’єкт 3-го рівня"

#. kind: t
#: game/econ_guide.gd:455
msgid "Четвёртый город"
msgstr "Четверте місто"

#. kind: t
#: game/econ_guide.gd:455
msgid "Ещё +%d очков и доход. Колония за морем тоже считается: порт → «КОЛОНИЯ»."
msgstr "Ще +%d очок і дохід. Колонія за морем теж рахується: порт → «КОЛОНІЯ»."

#. kind: t
#: game/econ_guide.gd:456
msgid "Основан четвёртый город"
msgstr "Засновано четверте місто"

#. kind: t
#: game/econ_guide.gd:457
msgid "Вторая армия"
msgstr "Друга армія"

#. kind: t
#: game/econ_guide.gd:457
msgid "Две полные казармы держат рубеж, пока вы отвечаете на удар. Режим «ОБОРОНА» — армия сама встаёт у городов."
msgstr "Дві повні казарми тримають рубіж, поки ви відповідаєте на удар. Режим «ОБОРОНА» — армія сама стає біля міст."

#. kind: t
#: game/econ_guide.gd:458
msgid "Две армии"
msgstr "Дві армії"

#. kind: t
#: game/econ_guide.gd:465
msgid "покупка на рынке («КУПИТЬ НЕХВАТКУ»)"
msgstr "купівля на ринку («КУПИТИ НЕСТАЧУ»)"

#. kind: t
#: game/econ_guide.gd:468
msgid "улучшите свой титановый рудник"
msgstr "покращте свій титановий рудник"

#. kind: t
#: game/econ_guide.gd:471
msgid "рудник на голубой залежи"
msgstr "рудник на блакитному покладі"

#. kind: t
#: game/econ_guide.gd:473
msgid "рудник работает; быстрее — покупка"
msgstr "рудник працює; швидше — купівля"

#. kind: t
#: game/econ_guide.gd:474
msgid "Запас титана: 40"
msgstr "Запас титану: 40"

#. kind: t
#: game/econ_guide.gd:474
msgid "Титан нужен ракетам, танкам и самолётам (у вас %d): %s."
msgstr "Титан потрібен ракетам, танкам і літакам (у вас %d): %s."

#. kind: t
#: game/econ_guide.gd:475
msgid "Запас титана"
msgstr "Запас титану"

#. kind: t
#: game/econ_guide.gd:477
msgid "Второй договор: пропуск"
msgstr "Другий договір: пропуск"

#. kind: t
#: game/econ_guide.gd:477
msgid "Больше подписать не с кем."
msgstr "Більше підписати ні з ким."

#. kind: t
#: game/econ_guide.gd:479
msgid "Второй договор"
msgstr "Другий договір"

#. kind: t
#: game/econ_guide.gd:479
msgid "Ещё один покупатель для излишков: торговля идёт в доход, доход — в очки."
msgstr "Ще один покупець для надлишків: торгівля йде в дохід, дохід — в очки."

#. kind: t
#: game/econ_guide.gd:480
msgid "Два торговых договора"
msgstr "Два торгові договори"

#. kind: t
#: game/econ_guide.gd:481
msgid "Бетон над ТЭЦ"
msgstr "Бетон над ТЕЦ"

#. kind: t
#: game/econ_guide.gd:481
msgid "Бетон гасит крылатые и баллистические ракеты (сетка — нет). Потерянная ТЭЦ останавливает все заводы и доход."
msgstr "Бетон гасить крилаті й балістичні ракети (сітка — ні). Втрачена ТЕЦ зупиняє всі заводи й дохід."

#. kind: t
#: game/econ_guide.gd:482
msgid "Бетон залит"
msgstr "Бетон залито"

#. kind: t
#: game/econ_guide.gd:483
msgid "Пятый город"
msgstr "П’яте місто"

#. kind: t
#: game/econ_guide.gd:483
msgid "Пять городов — заметный отрыв по очкам (+%d за город) и доходу."
msgstr "П’ять міст — помітний відрив за очками (+%d за місто) і доходом."

#. kind: t
#: game/econ_guide.gd:484
msgid "Основан пятый город"
msgstr "Засновано п’яте місто"

#. kind: t
#: game/econ_guide.gd:485
msgid "Предприятия: %d/10"
msgstr "Підприємства: %d/10"

#. kind: t
#: game/econ_guide.gd:485
msgid "Десять предприятий — +250 очков и доход, который сам растит счёт."
msgstr "Десять підприємств — +250 очок і дохід, який сам ростить рахунок."

#. kind: t
#: game/econ_guide.gd:486
msgid "Десять предприятий"
msgstr "Десять підприємств"

#. kind: t
#: game/econ_guide.gd:1122
msgid "Сеть %d/%d: свободно %d энергии (заводу, руднику, НПЗ нужно по 1)."
msgstr "Мережа %d/%d: вільно %d енергії (заводу, руднику, НПЗ потрібно по 1)."

#. kind: t
#: game/econ_guide.gd:1127
msgid "зданий: %d"
msgstr "будівель: %d"

#. kind: t
#: game/econ_guide.gd:1129
msgid "городов: %d"
msgstr "міст: %d"

#. kind: t
#: game/econ_guide.gd:1130
msgid "Сеть перегружена %d/%d: без света %s — постройте ТЭЦ или солнечную станцию."
msgstr "Мережу перевантажено %d/%d: без світла %s — збудуйте ТЕЦ або сонячну станцію."

#. kind: t
#: game/econ_guide.gd:1130
msgid "часть потребителей"
msgstr "частина споживачів"

#. kind: t
#: game/econ_guide.gd:1133
msgid "Сеть на пределе %d/%d: следующий завод останется без света — нужна ещё станция."
msgstr "Мережа на межі %d/%d: наступний завод залишиться без світла — потрібна ще станція."

#. kind: t
#: game/econ_guide.gd:1142
msgid "Еды хватает: +%d в минуту, армия ест %d."
msgstr "Їжі вистачає: +%d за хвилину, армія їсть %d."

#. kind: t
#: game/econ_guide.gd:1149
msgid "Колхозов нет: еда понадобится армии, а колхоз ещё и приносит деньги."
msgstr "Ферм немає: їжа знадобиться армії, а ферма ще й приносить гроші."

#. kind: t
#: game/econ_guide.gd:1152
msgid "Армия голодает: еды нет — постройте колхоз или купите еду в торговле."
msgstr "Армія голодує: їжі немає — збудуйте ферму або купіть їжу в торгівлі."

#. kind: t
#: game/econ_guide.gd:1155
msgid "Колхозы на паузе — еда не растёт."
msgstr "Ферми на паузі — їжа не росте."

#. kind: t
#: game/econ_guide.gd:1158
msgid "Еда убывает (%d в минуту): запаса на ~%d мин — нужен ещё колхоз."
msgstr "Їжа зменшується (%d за хвилину): запасу на ~%d хв — потрібна ще ферма."

#. kind: t
#: game/econ_guide.gd:1160
msgid "Склад еды полон: излишки продаются за полцены."
msgstr "Склад їжі повний: надлишки продаються за півціни."

#. kind: t
#: game/econ_guide.gd:1163
msgid "Колхоз → еда → армия"
msgstr "Ферма → їжа → армія"

#. kind: t
#: game/econ_guide.gd:1170
msgid "ТЭЦ, АЭС и солнце → сеть"
msgstr "ТЕЦ, АЕС і сонце → мережа"

#. kind: t
#: game/econ_guide.gd:1207
msgid "Урановая шахта → уран → АЭС"
msgstr "Уранова шахта → уран → АЕС"

#. kind: t
#: game/econ_guide.gd:1216
msgid "АЭС стоит без урана — купите уран в торговле или через порт%s."
msgstr "АЕС стоїть без урану — купіть уран у торгівлі або через порт%s."

#. kind: t
#: game/econ_guide.gd:1216
msgid ", или поставьте шахту на залежь"
msgstr ", або поставте шахту на поклад"

#. kind: t
#: game/econ_guide.gd:1220
msgid "Урана на %d мин работы АЭС — пополните запас."
msgstr "Урану на %d хв роботи АЕС — поповніть запас."

#. kind: t
#: game/econ_guide.gd:1223
msgid "На вашей земле залежь урана (зелёный значок): урановая шахта даёт топливо АЭС и дорогой товар."
msgstr "На вашій землі поклад урану (зелений значок): уранова шахта дає паливо АЕС і дорогий товар."

#. kind: t
#: game/econ_guide.gd:1227
msgid "Урана хватает на АЭС (%d): +%d энергии, но ей нужна ПВО."
msgstr "Урану вистачає на АЕС (%d): +%d енергії, але їй потрібна ППО."

#. kind: t
#: game/econ_guide.gd:1231
msgid "Уран %d%s."
msgstr "Уран %d%s."

#. kind: t
#: game/econ_guide.gd:1231
msgid " · АЭС на %d мин"
msgstr " · АЕС на %d хв"

#. kind: t
#: game/econ_guide.gd:1231
msgid " · излишки дорого продаются"
msgstr " · надлишки дорого продаються"

#. kind: t
#: game/econ_guide.gd:1263
msgid "Завод товаров → товары + деньги"
msgstr "Завод товарів → товари + гроші"

#. kind: t
#: game/econ_guide.gd:1276
msgid "Заводов товаров нет — это главный доход страны: +%d денег в минуту."
msgstr "Заводів товарів немає — це головний дохід країни: +%d грошей за хвилину."

#. kind: t
#: game/econ_guide.gd:1280
msgid "Завод товаров стоит без питания — постройте ТЭЦ или солнечную станцию."
msgstr "Завод товарів стоїть без живлення — збудуйте ТЕЦ або сонячну станцію."

#. kind: t
#: game/econ_guide.gd:1284
msgid "Завод товаров на паузе — денег не приносит."
msgstr "Завод товарів на паузі — грошей не приносить."

#. kind: t
#: game/econ_guide.gd:1287
msgid "%d из %d заводов без питания — нужна ещё станция."
msgstr "%d з %d заводів без живлення — потрібна ще станція."

#. kind: t
#: game/econ_guide.gd:1291
msgid "Склад товаров полон: излишки уходят за полцены — продайте их или постройте порт."
msgstr "Склад товарів повний: надлишки йдуть за півціни — продайте їх або збудуйте порт."

#. kind: t
#: game/econ_guide.gd:1295
msgid "Работает: +%d денег в минуту."
msgstr "Працює: +%d грошей за хвилину."

#. kind: t
#: game/econ_guide.gd:1313
msgid "Рудник → %s"
msgstr "Рудник → %s"

#. kind: t
#: game/econ_guide.gd:1321
msgid "Не хватает: %s (%d) — %s."
msgstr "Бракує: %s (%d) — %s."

#. kind: t
#: game/econ_guide.gd:1321
msgid "поставьте рудник на свободную залежь"
msgstr "поставте рудник на вільний поклад"

#. kind: t
#: game/econ_guide.gd:1321
msgid "купите в торговле или через порт"
msgstr "купіть у торгівлі або через порт"

#. kind: t
#: game/econ_guide.gd:1324
msgid "На вашей земле свободная залежь: %s — поставьте на неё рудник."
msgstr "На вашій землі вільний поклад: %s — поставте на нього рудник."

#. kind: t
#: game/econ_guide.gd:1327
msgid "В вашем регионе нет залежей: %s — покупайте в торговле или через порт."
msgstr "У вашому регіоні немає покладів: %s — купуйте в торгівлі або через порт."

#. kind: t
#: game/econ_guide.gd:1330
msgid "Рудника нет: ищите залежь (%s) у границ и основайте рядом город."
msgstr "Рудника немає: шукайте поклад (%s) біля кордонів і заснуйте поруч місто."

#. kind: t
#: game/econ_guide.gd:1356
msgid "Рудник стоит без питания — постройте ТЭЦ или солнечную станцию."
msgstr "Рудник стоїть без живлення — збудуйте ТЕЦ або сонячну станцію."

#. kind: t
#: game/econ_guide.gd:1360
msgid "Залежь исчерпана — поставьте рудник на другую залежь или покупайте %s."
msgstr "Поклад вичерпано — поставте рудник на інший поклад або купуйте %s."

#. kind: t
#: game/econ_guide.gd:1364
msgid "Склад полон (%d) — продайте излишки в торговле или постройте порт."
msgstr "Склад повний (%d) — продайте надлишки в торгівлі або збудуйте порт."

#. kind: t
#: game/econ_guide.gd:1368
msgid "Рудник на паузе — добычи нет."
msgstr "Рудник на паузі — видобутку немає."

#. kind: t
#: game/econ_guide.gd:1372
msgid "%d рудник(а) без питания — нужна ещё станция."
msgstr "%d рудник(и) без живлення — потрібна ще станція."

#. kind: t
#: game/econ_guide.gd:1376
msgid "Расход (%d) больше добычи (%d) — ещё рудник, улучшение или покупка."
msgstr "Витрата (%d) більша за видобуток (%d) — ще рудник, покращення або купівля."

#. kind: t
#: game/econ_guide.gd:1380
msgid "Залежь кончается: осталось %d — найдите новую."
msgstr "Поклад закінчується: залишилося %d — знайдіть новий."

#. kind: t
#: game/econ_guide.gd:1384
msgid "Добыча +%d в минуту, запас %d."
msgstr "Видобуток +%d за хвилину, запас %d."

#. kind: t
#: game/econ_guide.gd:1391
msgid "Лесопилка → дерево"
msgstr "Лісопилка → деревина"

#. kind: t
#: game/econ_guide.gd:1399
msgid "Лесопилки нет: дерево (у вас %d) нужно почти везде — ставьте у леса."
msgstr "Лісопилки немає: деревина (у вас %d) потрібна майже скрізь — ставте біля лісу."

#. kind: t
#: game/econ_guide.gd:1421
msgid "Лес вокруг лесопилки вырублен — поставьте новую у леса (пни отрастают за 8 мин)."
msgstr "Ліс довкола лісопилки вирубано — поставте нову біля лісу (пні відростають за 8 хв)."

#. kind: t
#: game/econ_guide.gd:1421
msgid "Лес у лесопилки вырублен; дерева пока хватает (%d/%d). Новую лесопилку — у леса."
msgstr "Ліс біля лісопилки вирубано; деревини поки вистачає (%d/%d). Нову лісопилку — біля лісу."

#. kind: t
#: game/econ_guide.gd:1425
msgid "Склад дерева полон — продайте излишки."
msgstr "Склад деревини повний — продайте надлишки."

#. kind: t
#: game/econ_guide.gd:1429
msgid "Лесопилка на паузе."
msgstr "Лісопилка на паузі."

#. kind: t
#: game/econ_guide.gd:1432
msgid "Рубка +%d в минуту, запас %d."
msgstr "Рубка +%d за хвилину, запас %d."

#. kind: t
#: game/econ_guide.gd:1441
msgid "Нефть → НПЗ → топливо"
msgstr "Нафта → НПЗ → пальне"

#. kind: t
#: game/econ_guide.gd:1451
msgid "Нефтяная залежь на вашей земле: нефтевышка → НПЗ → топливо (продаётся само)."
msgstr "Нафтовий поклад на вашій землі: нафтова вишка → НПЗ → пальне (продається саме)."

#. kind: t
#: game/econ_guide.gd:1454
msgid "Нефти в вашем регионе нет: НПЗ возможен только на покупной нефти."
msgstr "Нафти у вашому регіоні немає: НПЗ можливий лише на купованій нафті."

#. kind: t
#: game/econ_guide.gd:1457
msgid "Нефти нет: ищите чёрный значок залежи у границ."
msgstr "Нафти немає: шукайте чорний значок покладу біля кордонів."

#. kind: t
#: game/econ_guide.gd:1462
msgid "Нефть копится (%d/%d): постройте НПЗ — топливо дороже сырой нефти."
msgstr "Нафта накопичується (%d/%d): збудуйте НПЗ — пальне дорожче за сиру нафту."

#. kind: t
#: game/econ_guide.gd:1465
msgid "Нефть +%d в минуту. Дальше — НПЗ (на постройку нужна нефть 20)."
msgstr "Нафта +%d за хвилину. Далі — НПЗ (на будівництво потрібна нафта 20)."

#. kind: t
#: game/econ_guide.gd:1480
msgid "НПЗ стоит без питания — постройте ТЭЦ или солнечную станцию."
msgstr "НПЗ стоїть без живлення — збудуйте ТЕЦ або сонячну станцію."

#. kind: t
#: game/econ_guide.gd:1484
msgid "НПЗ на паузе."
msgstr "НПЗ на паузі."

#. kind: t
#: game/econ_guide.gd:1487
msgid "НПЗ стоит: нет нефти — постройте нефтевышку или купите нефть."
msgstr "НПЗ стоїть: немає нафти — збудуйте нафтову вишку або купіть нафту."

#. kind: t
#: game/econ_guide.gd:1491
msgid "Нефти мало: НПЗ может перерабатывать %d в минуту, вышки дают %d — ещё вышка или закупка."
msgstr "Нафти мало: НПЗ може переробляти %d за хвилину, вишки дають %d — ще вишка або закупівля."

#. kind: t
#: game/econ_guide.gd:1496
msgid "Топливо +%d в минуту, продажа излишков +%d денег."
msgstr "Пальне +%d за хвилину, продаж надлишків +%d грошей."

#. kind: t
#: game/econ_guide.gd:1498
msgid "Топливо +%d в минуту копится в резерв авиации (%d), сверх него продаётся само."
msgstr "Пальне +%d за хвилину накопичується в резерв авіації (%d), понад нього продається саме."

#. kind: t,table:LOC_TUT337_TITLES
#: game/econ_guide.gd:1510 ui/ui24/tutorial_feed.gd:34 ui/ui24/tutorial_feed.gd:35
msgid "Торговля и порт"
msgstr "Торгівля й порт"

#. kind: t
#: game/econ_guide.gd:1529
msgid "Продайте излишки: %s (склад полон)."
msgstr "Продайте надлишки: %s (склад повний)."

#. kind: t
#: game/econ_guide.gd:1533 game/econ_guide.gd:1544
msgid "Не хватает: %s %d — купите в окне торговли."
msgstr "Бракує: %s %d — купіть у вікні торгівлі."

#. kind: t
#: game/econ_guide.gd:1539
msgid "В вашем регионе нет: %s — это покупают. "
msgstr "У вашому регіоні немає: %s — це купують. "

#. kind: t
#: game/econ_guide.gd:1539
msgid "Договор с соседом сам продаёт излишки."
msgstr "Договір із сусідом сам продає надлишки."

#. kind: t
#: game/econ_guide.gd:1548
msgid "Договоров: %d%s. Доход от торговли +%d в минуту."
msgstr "Договорів: %d%s. Дохід від торгівлі +%d за хвилину."

#. kind: t
#: game/econ_guide.gd:1548
msgid ", порт вывозит излишки"
msgstr ", порт вивозить надлишки"

#. kind: t
#: game/econ_guide.gd:1557
msgid "Металл → дронный завод → дроны"
msgstr "Метал → завод дронів → дрони"

#. kind: t
#: game/econ_guide.gd:1579
msgid "Дронный завод без питания — постройте ТЭЦ или солнечную станцию."
msgstr "Завод дронів без живлення — збудуйте ТЕЦ або сонячну станцію."

#. kind: t
#: game/econ_guide.gd:1583
msgid "Дронный завод на паузе."
msgstr "Завод дронів на паузі."

#. kind: t
#: game/econ_guide.gd:1586
msgid "Дронам некуда садиться — постройте дронопорт."
msgstr "Дронам нікуди сідати — збудуйте дронопорт."

#. kind: t
#: game/econ_guide.gd:1590
msgid "Дронопорты полны (%d/%d): запускайте дроны или добавьте склад / дронопорт."
msgstr "Дронопорти повні (%d/%d): запускайте дрони або додайте склад / дронопорт."

#. kind: t
#: game/econ_guide.gd:1594 game/econ_guide.gd:1644
msgid "Завод ждёт: не хватает %s — %s."
msgstr "Завод чекає: бракує %s — %s."

#. kind: t
#: game/econ_guide.gd:1594
msgid "рудник на залежи металла или покупка"
msgstr "рудник на покладі металу або купівля"

#. kind: t
