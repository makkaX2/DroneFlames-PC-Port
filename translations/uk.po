msgid "%s %d (у вас %d): %s"
msgstr "%s %d (у вас %d): %s"

#. kind: t
#: game/economy/eco_trade.gd:1179
msgid "Здание"
msgstr "Будівля"

#. kind: t
#: game/economy/eco_trade.gd:1183
msgid "%s: нужно %s"
msgstr "%s: потрібно %s"

#. kind: t
#: game/economy/eco_trade.gd:1187
msgid "На вашей земле нет свободной залежи руды — расширяйте границы городом к значку руды."
msgstr "На вашій землі немає вільного покладу руди — розширюйте кордони містом до значка руди."

#. kind: t
#: game/economy/eco_trade.gd:1190
msgid "На вашей земле нет свободной залежи урана (зелёный значок) — она редкая: расширяйте границы к ней или покупайте уран."
msgstr "На вашій землі немає вільного покладу урану (зелений значок) — він рідкісний: розширюйте кордони до нього або купуйте уран."

#. kind: t
#: game/economy/eco_trade.gd:1192
msgid "АЭС: сетки и бетон её не защищают — ставьте рядом ЗРК и ПРО. +%d энергии, 1 уран на %d с работы."
msgstr "АЕС: сітки й бетон її не захищають — ставте поруч ЗРК і ПРО. +%d енергії, 1 уран на %d с роботи."

#. kind: t
#: game/economy/eco_trade.gd:1195
msgid "На вашей земле нет нефтяной залежи (чёрный значок) — расширяйте границы или покупайте нефть."
msgstr "На вашій землі немає нафтового покладу (чорний значок) — розширюйте кордони або купуйте нафту."

#. kind: t
#: game/economy/eco_trade.gd:1198
msgid "Ставьте у леса: нужно от %d деревьев рядом, лесопилка вырубает их постепенно."
msgstr "Ставте біля лісу: потрібно від %d дерев поруч, лісопилка вирубує їх поступово."

#. kind: t
#: game/economy/eco_trade.gd:1201
msgid "Порт строится на берегу моря на вашей земле, вплотную к воде: свободного берега нет."
msgstr "Порт будується на березі моря на вашій землі, впритул до води: вільного берега немає."

#. kind: t
#: game/economy/eco_trade.gd:1204
msgid "Кран ставится рядом с вашим портом: сначала постройте порт."
msgstr "Кран ставиться поруч із вашим портом: спершу збудуйте порт."

#. kind: t
#: game/economy/eco_trade.gd:1207
msgid "НПЗ перерабатывает нефть в топливо: без нефтевышки или закупок нефти он будет стоять."
msgstr "НПЗ переробляє нафту на пальне: без нафтової вишки або закупівель нафти він стоятиме."

#. kind: t
#: game/economy/eco_trade.gd:1210
msgid "Каждый дрон стоит металл %d: нужен %s."
msgstr "Кожен дрон коштує метал %d: потрібен %s."

#. kind: t
#: game/economy/eco_trade.gd:1213
msgid "Ракеты делаются из титана (баллистическая — %d): нужен %s."
msgstr "Ракети виготовляють із титану (балістична — %d): потрібен %s."

#. kind: t
#: game/economy/eco_trade.gd:1216
msgid "Самолёты: титан 10–60 и драгметаллы для истребителей и бомбардировщиков."
msgstr "Літаки: титан 10–60 і дорогоцінні метали для винищувачів і бомбардувальників."

#. kind: t
#: game/economy/eco_trade.gd:1219
msgid "Нужна 1 энергия, а сеть занята (%d/%d): сначала ТЭЦ или солнечная станция, иначе здание будет стоять."
msgstr "Потрібна 1 енергія, а мережа зайнята (%d/%d): спершу ТЕЦ або сонячна станція, інакше будівля стоятиме."

#. kind: t
#: game/economy/eco_trade.gd:1223
msgid "Цепочка: нефтевышка → нефть → НПЗ → топливо. Без вышки НПЗ встанет, когда кончится запас нефти."
msgstr "Ланцюжок: нафтова вишка → нафта → НПЗ → пальне. Без вишки НПЗ стане, коли скінчиться запас нафти."

#. kind: t
#: game/economy/eco_trade.gd:1226
msgid "Дальше — НПЗ: он делает из нефти топливо, которое продаётся дороже (на постройку нужна нефть 20)."
msgstr "Далі — НПЗ: він робить із нафти пальне, яке продається дорожче (на будівництво потрібна нафта 20)."

#. kind: t
#: game/economy/eco_trade.gd:1229
msgid "Готовые дроны садятся в дронопорт — без него завод ждёт."
msgstr "Готові дрони сідають у дронопорт — без нього завод чекає."

#. kind: t
#: game/economy/eco_trade.gd:1252
msgid "Дерево кончается: поставьте лесопилку у леса — дерево нужно почти для всех построек."
msgstr "Деревина закінчується: поставте лісопилку біля лісу — деревина потрібна майже для всіх будівель."

#. kind: t
#: game/economy/eco_trade.gd:1254
msgid "НПЗ стоит без нефти: нефтевышка на чёрном значке или купите нефть в торговле."
msgstr "НПЗ стоїть без нафти: нафтова вишка на чорному значку або купіть нафту в торгівлі."

#. kind: t
#: game/economy/eco_trade.gd:1261
msgid "На вашей земле есть залежь: %s — поставьте %s прямо на значок."
msgstr "На вашій землі є поклад: %s — поставте %s просто на значок."

#. kind: t
#: game/economy/eco_trade.gd:1265
msgid "Не хватает: %s %d — %s."
msgstr "Бракує: %s %d — %s."

#. kind: t
#: game/economy/eco_trade.gd:1269
msgid "Склад «%s» полон: продайте излишки в торговле — порт вывозит их и сам."
msgstr "Склад «%s» повний: продайте надлишки в торгівлі — порт вивозить їх і сам."

#. kind: t
#: game/economy/eco_trade.gd:1270
msgid "Склад «%s» полон: продайте излишки в торговле или постройте порт — он вывозит излишки за рубеж."
msgstr "Склад «%s» повний: продайте надлишки в торгівлі або збудуйте порт — він вивозить надлишки за кордон."

#. kind: t
#: game/economy/eco_trade.gd:1274
msgid "%s просит %s ×%d дороже рынка — ответьте в окне торговли."
msgstr "%s просить %s ×%d дорожче за ринок — відповідайте у вікні торгівлі."

#. kind: t
#: game/economy/eco_trade.gd:1274
msgid "Сосед"
msgstr "Сусід"

#. kind: t
#: game/economy/eco_trade.gd:1279
msgid "Можно улучшить «%s» до уровня %d: выпуск ×%.1f."
msgstr "Можна покращити «%s» до рівня %d: випуск ×%.1f."

#. kind: t
#: game/economy/eco_trade.gd:1296
msgid "Казармы стоят"
msgstr "Казарми стоять"

