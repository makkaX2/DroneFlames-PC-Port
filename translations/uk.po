msgid "СНЯТЬ НЕБО"
msgstr "ЗНЯТИ НЕБО"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1403
msgid "Небо снято: ваши ПВО едут домой"
msgstr "Небо знято: ваша ППО їде додому"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1404
msgid "ПОСТАВИТЬ ПВО У НИХ"
msgstr "ПОСТАВИТИ ППО В НИХ"

#. cat=static zone=ui uses=2
#: ui/ui24/dip_page.gd:1411 ui/ui24/dip_page.gd:2029
msgid "Предложение отозвано"
msgstr "Пропозицію відкликано"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1412
msgid "предложено · ждём ответа "
msgstr "запропоновано · чекаємо відповіді "

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1414
msgid "они просят закрыть небо над ними · ответ во «Входящих»"
msgstr "вони просять закрити небо над ними · відповідь у «Вхідних»"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1419
msgid "Небо закрыто"
msgstr "Небо закрито"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1428
msgid "УВЕЗТИ ДОМОЙ"
msgstr "ВИВЕЗТИ ДОДОМУ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1428
msgid "ПВО едет на вашу землю"
msgstr "ППО їде на вашу землю"

#. cat=static zone=ui uses=4
#: ui/ui24/dip_page.gd:1434 ui/ui24/dip_page.gd:1440 ui/ui24/dip_page.gd:1444
#: ui/ui24/dip_page.gd:1448
msgid "НАДО МНОЙ"
msgstr "НАДІ МНОЮ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1438
msgid "Их небо над вами снято"
msgstr "Їхнє небо над вами знято"

#. cat=static zone=ui uses=2
#: ui/ui24/dip_page.gd:1441 ui/ui24/dip_page.gd:2206
msgid "Просьба отозвана"
msgstr "Прохання відкликано"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1442
msgid "просьба отправлена · ждём ответа "
msgstr "прохання надіслано · чекаємо відповіді "

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1444
msgid "они предлагают закрыть небо над вами"
msgstr "вони пропонують закрити небо над вами"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1449
msgid "Просьба отправлена"
msgstr "Прохання надіслано"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1450
msgid "Враг союзника может сбивать ваши ПВО над ним — это не объявление войны вам."
msgstr "Ворог союзника може збивати вашу ППО над ним — це не оголошення війни вам."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1507
msgid "АРМИЯ НА ЗАЩИТУ"
msgstr "АРМІЯ НА ЗАХИСТ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1514
msgid "ИХ АРМИЯ У ВАС"
msgstr "ЇХНЯ АРМІЯ У ВАС"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1518
msgid "Их армия уходит домой"
msgstr "Їхня армія йде додому"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1530
msgid "Вернуть армию домой? Разрешение закончится, отряды уйдут с их земли к границе."
msgstr "Повернути армію додому? Дозвіл закінчиться, загони підуть з їхньої землі до кордону."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1531
msgid "Армия возвращается домой"
msgstr "Армія повертається додому"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1534
msgid "РАЗРЕШЕНИЕ ЕСТЬ"
msgstr "ДОЗВІЛ Є"

#. cat=static zone=ui uses=3
#: ui/ui24/dip_page.gd:1541 ui/ui24/dip_page.gd:1551 ui/ui24/dip_page.gd:1557
msgid "ОТПРАВИТЬ АРМИЮ"
msgstr "ВІДПРАВИТИ АРМІЮ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1541
msgid "союзнику согласие не нужно · вы ею управляете там"
msgstr "союзнику згода не потрібна · ви нею керуєте там"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1551
msgid "просили согласие · ждём ответа"
msgstr "просили згоду · чекаємо відповіді"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1569
msgid "Без войны: ваша армия бьёт врага только на их земле. Агрессор может объявить вам войну."
msgstr "Без війни: ваша армія б’є ворога лише на їхній землі. Агресор може оголосити вам війну."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1603
msgid "Нет армий с солдатами: постройте казарму и наберите войска."
msgstr "Немає армій із солдатами: збудуйте казарму й наберіть війська."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1626
msgid "ВОЕННАЯ ПОМОЩЬ"
msgstr "ВІЙСЬКОВА ДОПОМОГА"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1626
msgid "нужно место у них"
msgstr "потрібне місце в них"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1644
msgid "нет места"
msgstr "немає місця"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1655
msgid "Скоро: ракеты ПВО в помощи"
msgstr "Незабаром: ракети ППО в допомозі"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1675
msgid "дронопорт"
msgstr "дронопорт"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1675
msgid "нет мест"
msgstr "немає місць"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1675
msgid "отрк"
msgstr "отрк"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1675
msgid "зрк"
msgstr "зрк"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1675
msgid "нет ЗРК"
msgstr "немає ЗРК"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1675
msgid "носител"
msgstr ""

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1675
msgid "пусков"
msgstr ""

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1675
msgid "нет пусковой"
msgstr "немає пускової"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1693
msgid "Союзнику ультиматум не ставят — сначала расторгните союз."
msgstr "Союзнику ультиматум не ставлять — спершу розірвіть союз."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1720
msgid "ВОЙНА НЕЛЬЗЯ"
msgstr "ВІЙНУ НЕ МОЖНА"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1730
msgid "ОТОЗВАТЬ ПРОХОД"
msgstr "ВІДКЛИКАТИ ПРОХІД"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1732
msgid "Право прохода отозвано: их войска уходят"
msgstr "Право проходу відкликано: їхні війська йдуть"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1742
msgid "ВЫВЕСТИ ВОЙСКА"
msgstr "ВИВЕСТИ ВІЙСЬКА"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1744
msgid "Наши войска уходят к границе"
msgstr "Наші війська йдуть до кордону"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1748
msgid "РАЗОРВАТЬ СОЮЗ"
msgstr "РОЗІРВАТИ СОЮЗ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1769
msgid "−60 к отношениям с ними, все договоры сгорят"
msgstr "−60 до відносин із ними, усі договори згорять"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1771
msgid "Вероломство: −15 к отношениям со всеми странами"
msgstr "Віроломство: −15 до відносин з усіма країнами"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1773
msgid "Союз и договоры сгорят: −60 с ними, их союзники против вас"
msgstr "Союз і договори згорять: −60 з ними, їхні союзники проти вас"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1782
msgid "ТОРГОВЛИ НЕТ — ВОЙНА"
msgstr "ТОРГІВЛІ НЕМАЄ — ВІЙНА"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1782
msgid "санкции и эмбарго — против стран, с кем вы в мире"
msgstr "санкції та ембарго — проти країн, з якими ви в мирі"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1783
msgid "Давить на агрессора лучше чужими руками: попросите союзников «прекратить войну» — их санкции бьют по нему."
msgstr "Тиснути на агресора краще чужими руками: попросіть союзників «припинити війну» — їхні санкції б’ють по ньому."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1789
msgid "деньги и сырьё · отношения растут"
msgstr "гроші й сировина · відносини ростуть"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1818
msgid "потребовали · ждём ответа"
msgstr "вимагали · чекаємо відповіді"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1819
msgid "Требование отозвано"
msgstr "Вимогу відкликано"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1824
msgid "отказали · повтор через "
msgstr "відмовили · повтор за "

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1847
msgid "Отказ — не война: давите санкциями на материал, потом полным эмбарго — до перемирия. Снимутся сами после мира."
msgstr "Відмова — не війна: тисніть санкціями на матеріал, потім повним ембарго — до перемир’я. Знімуться самі після миру."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1864
msgid "не продаём и не покупаем выбранное"
msgstr "не продаємо й не купуємо вибране"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1867
msgid "полное эмбарго: не продаём ничего"
msgstr "повне ембарго: не продаємо нічого"

#. cat=static zone=ui uses=2
#: ui/ui24/dip_page.gd:1875 ui/ui24/my_state.gd:1454
msgid "САНКЦИИ"
msgstr "САНКЦІЇ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1915
msgid "Эмбарго уже запрещает всю торговлю с ними"
msgstr "Ембарго вже забороняє всю торгівлю з ними"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1919
msgid "Скоро: санкции на отдельный материал"
msgstr "Незабаром: санкції на окремий матеріал"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1951
msgid "Санкции введены"
msgstr "Санкції запроваджено"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1951
msgid "Санкции сняты"
msgstr "Санкції знято"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1988
msgid "Снять эмбарго? Торговля с ними откроется."
msgstr "Зняти ембарго? Торгівля з ними відкриється."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:1991
msgid "ПОЛНОЕ ЭМБАРГО"
msgstr "ПОВНЕ ЕМБАРГО"

#. cat=static zone=ui uses=2
#: ui/ui24/dip_page.gd:2012 ui/ui24/my_state.gd:1456
msgid "КОНТРАКТЫ"
msgstr "КОНТРАКТИ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2012
msgid "только между живыми игроками онлайн"
msgstr "лише між живими гравцями онлайн"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2030
msgid "ждёт ответа · "
msgstr "чекає відповіді · "

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2033
msgid "предлагают вам · ответ до "
msgstr "пропонують вам · відповідь до "

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2043
msgid "Контракт заключён"
msgstr "Контракт укладено"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2049
msgid "просят расторгнуть · без неустойки"
msgstr "просять розірвати · без неустойки"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2050
msgid "Контракт расторгнут по согласию"
msgstr "Контракт розірвано за згодою"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2054
msgid "РАЗОРВАТЬ"
msgstr "РОЗІРВАТИ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2075
msgid "Просьба о разрыве отправлена"
msgstr "Прохання про розрив надіслано"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2081
msgid "Контракт разорван"
msgstr "Контракт розірвано"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2091
msgid "НОВЫЙ КОНТРАКТ"
msgstr "НОВИЙ КОНТРАКТ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2127
msgid "объём"
msgstr "обсяг"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2127
msgid "срок"
msgstr "строк"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2175
msgid "Контракт предложен: ответ во «Входящих»"
msgstr "Контракт запропоновано: відповідь у «Вхідних»"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2185
msgid "ПРОСЯТ ВАС"
msgstr "ПРОСЯТЬ ВАС"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2185
msgid "ответьте до конца таймера"
msgstr "відповідайте до кінця таймера"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2192
msgid "ВЫ ПРОСИЛИ"
msgstr "ВИ ПРОСИЛИ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2213
msgid "ПРАВО ПРОХОДА ЧЕРЕЗ НИХ"
msgstr "ПРАВО ПРОХОДУ ЧЕРЕЗ НИХ"

#. cat=static zone=ui uses=2
#: ui/ui24/dip_page.gd:2213 ui/ui24/dip_page.gd:2217
msgid "ждёт ответа"
msgstr "чекає відповіді"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2217
msgid "ПРОХОД ЧЕРЕЗ НАС (предложили)"
msgstr "ПРОХІД ЧЕРЕЗ НАС (запропонували)"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2218
msgid "НОВАЯ ПРОСЬБА"
msgstr "НОВЕ ПРОХАННЯ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2219
msgid "ПОПРОСИТЬ…"
msgstr "ПОПРОСИТИ…"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2229
msgid "Соперник: просьбы примет вряд ли — честно предупреждаем."
msgstr "Суперник: прохання навряд чи прийме — чесно попереджаємо."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2293
msgid "Их ПВО встанут на вашей земле и будут сбивать ваших врагов."
msgstr "Їхня ППО стане на вашій землі й збиватиме ваших ворогів."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2299
msgid "Отказ — не война: дальше санкции на материал, затем полное эмбарго — до перемирия."
msgstr "Відмова — не війна: далі санкції на матеріал, потім повне ембарго — до перемир’я."

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2324
msgid "скорее да"
msgstr "радше так"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2328
msgid "скорее нет"
msgstr "радше ні"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2343
msgid "ЧТО ПОПРОСИТЬ"
msgstr "ЩО ПОПРОСИТИ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2343
msgid "ПРОВЕРИТЬ И ОТПРАВИТЬ"
msgstr "ПЕРЕВІРИТИ Й НАДІСЛАТИ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2367
msgid "Объявить войну — кому?"
msgstr "Оголосити війну — кому?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2367
msgid "Закрыть небо — над кем?"
msgstr "Закрити небо — над ким?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2367
msgid "Вступить в войну — против кого?"
msgstr "Вступити у війну — проти кого?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2368
msgid "Прекратить войну — с кем?"
msgstr "Припинити війну — з ким?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2368
msgid "Защищать их — от кого?"
msgstr "Захищати їх — від кого?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2368
msgid "Кого?"
msgstr "Кого?"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2387
msgid "нельзя: вы ни с кем не воюете"
msgstr "не можна: ви ні з ким не воюєте"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2405
msgid "выберите страну"
msgstr "виберіть країну"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2405
msgid "их ПВО прикроют выбранную страну"
msgstr "їхня ППО прикриє вибрану країну"

#. cat=static zone=ui uses=2
#: ui/ui24/dip_page.gd:2405 ui/ui24/dip_page.gd:2405
msgid "выберите войну"
msgstr "виберіть війну"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2406
msgid "без войны · выберите их войну"
msgstr "без війни · виберіть їхню війну"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2477
msgid "это вы"
msgstr "це ви"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2486
msgid "ВОЙНА с вами"
msgstr "ВІЙНА з вами"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2489
msgid "ваш союзник"
msgstr "ваш союзник"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2507
msgid "уже воюют · просить незачем"
msgstr "уже воюють · просити нема навіщо"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_page.gd:2626
msgid "ОТВЕТ"
msgstr "ВІДПОВІДЬ"

#. cat=static zone=ui uses=1
#: ui/ui24/dip_sheet.gd:434
msgid "нет договоров"
msgstr "немає договорів"

