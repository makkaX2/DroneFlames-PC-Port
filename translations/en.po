msgstr "Armies fight on their own, by their MODE. Gather them into a group (ARMY) and draw a front line — the border holds without extra taps."

#. cat=static zone=ui uses=1
#: ui/ui24/help_tips.gd:21
msgid "ЛИНИЯ ФРОНТА"
msgstr "FRONT LINE"

#. cat=static zone=ui uses=1
#: ui/ui24/help_tips.gd:21
