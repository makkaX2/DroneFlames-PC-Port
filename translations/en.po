msgstr "Country development «DEVELOPING» needed: %d / %d points"

msgid "Нужен город (не посёлок) без своего аэропорта"
msgstr "Needs a city (not a village) without an airport of its own"

msgid "Городу рядом с аэропортом нужно электричество: постройте ТЭЦ"
msgstr "The city by the airport needs power: build a power plant"

