# Git LFS tracking for binaries over GitHub file size limits
*.exe filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.pck filter=lfs diff=lfs merge=lfs -text
*.sparsepck filter=lfs diff=lfs merge=lfs -text

# Line endings normalization
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.iss text eol=crlf
*.bat text eol=crlf
